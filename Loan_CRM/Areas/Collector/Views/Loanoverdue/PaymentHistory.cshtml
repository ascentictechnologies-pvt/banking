    function GetPreterm(AppId,balance) {
        //
        var applicationno = AppId;
        _ApplicationNo = AppId;
        var BalanceAmount = balance;
        var modalPreterm = document.getElementById('modalPreterm');
        $("#txtPretermDeduction").val(BalanceAmount);

        modalPreterm.style.display = "block";
        BindTermName();
    }

    function GetReloan(AppId, balance) {
        var applicationno = AppId;
        _ApplicationNo = AppId;
        var BalanceAmount = balance;
        var modalReloan = document.getElementById('modalReloan');
        $("#txtReloanDeduction").val(BalanceAmount);

        modalReloan.style.display = "block";
    }

    function GetDataAccToTerm() {
        var termId = $("#ddlTermName option:selected").val();
        if (termId != "-1") {
            var temVal = termId.split('_');
            termId = temVal[0];
        }
        if (termId != undefined) {
            $.ajax({
                url: '@Url.Action("GetDataAccToTerm", "LoanRequestVerifier", new { Area = "Verifier" })',
                type: "POST",
                data: { id: termId },
                success: function (data) {
                    if (data != null) {
                        $("#txtTermType").val(data.TermTypeName);
                        $("#txtInterestRate").val(data.Rate);
                        $("#txtTerm_ValuePreterm").val(data.term_Value);
                        $("#txtAdminFeePreterm").val(data.admin_fee);
                        CalculateTotalAmount();
                    }
                    else {
                        window.location.reload(1);
                    }
                },
                error: function (data) {
                    window.location.reload(1);
                }
            });
        }
    }
    function GetDataAccToTermReloan() {
        var termId = $("#ddlTermNameReloan option:selected").val();
        if (termId != undefined) {
            $.ajax({
                url: '@Url.Action("GetDataAccToTerm", "LoanRequestVerifier", new { Area = "Verifier" })',
                type: "POST",
                data: { id: termId },
                success: function (data) {
                    if (data != null) {
                        $("#txtTermTypeReloan").val(data.TermTypeName);
                        $("#txtInterestRateReloan").val(data.Rate);
                        $("#txtTerm_ValueReloan").val(data.term_Value);
                        if ($("#ApprovedLoanAmountReloan").val() != 0) {
                        }
                    }
                    else {
                        window.location.reload(1);
                    }
                },
                error: function (data) {
                    window.location.reload(1);
                }
            });
        }
    }
     function BindTermName() {
            $.ajax({
            url: "/LoanRequestVerifier/Get_TermName",
            type: "POST",
                success: function (data) {
                    if (data != null) {
                        $('#ddlTermName').empty();
                        htmlText = '<option>Select</option>'
                        for (var i = 0; i < data.length; i++) {
                            htmlText += '<option value="' + data[i].Id + '_' + data[i].term_Id + '">' + data[i].term_Name + '</option>'
                        }
                        $('#ddlTermName').append(htmlText);
                    }
                    else {
                        window.location.reload(1);
                    }
                },
                error: function (data) {
                    window.location.reload(1);
                },
            complete: function (data) {
            }
            });
    }
    function BindTermNameReloan() {
        $.ajax({
            url: "/LoanRequestVerifier/Get_TermName",
            type: "POST",
            success: function (data) {
                if (data != null) {
                    for (var i = 0; i < data.length; i++) {
                        var opt = new Option(data[i].term_Name, data[i].Id);
                        $('#ddlTermNameReloan').append(opt);
                    }
                }
                else {
                    window.location.reload(1);
                }
            },
            error: function (data) {
                window.location.reload(1);
            },
            complete: function (data) {
                GetDataAccToTermReloan();
            }
        });
    }

    function CalculatePreterm() {
        //
        var LoanAmount = $("#txtLoanAmount").val();
        var TotalAmount = $("#txtTotalAmountDue").val();
        var PretermDeduction = $("#txtPretermDeduction").val();
        if (LoanAmount == "" || LoanAmount == NaN) {
            LoanAmount = 0;
        }
        if (PretermDeduction == "" || PretermDeduction == NaN) {
            PretermDeduction = 0;
        }
        var Total = parseFloat(TotalAmount) - parseFloat(PretermDeduction);
        $("#txtExactLoanAmountPerceived").val(Total);
        $("#txtTotalAmountDue").val(LoanAmount);
    }

    function CalculateReloan() {
        var LoanAmount = $("#txtLoanAmountReloan").val();
        var ReloanDeduction = $("#txtReloanDeduction").val();
        if (LoanAmount == "" || LoanAmount == NaN) {
            LoanAmount = 0;
        }
        if (ReloanDeduction == "" || ReloanDeduction == NaN) {
            ReloanDeduction = 0;
        }
        var Total = parseFloat(LoanAmount) - parseFloat(ReloanDeduction);
        $("#txtExactLoanAmountPerceivedReloan").val(Math.round(Total * 100) / 100);
        $("#txtTotalAmountDueReloan").val(LoanAmount);
    }
    function CalculateTotalAmount() {
        //
        var loanAmount = $("#txtLoanAmount").val().trim();
        if (loanAmount == '') {
            $("#txtTotalAmountDue").val(0);
        }
        else {
            var rate = $("#txtInterestRate").val();
            var adminfee = $("#txtAdminFeePreterm").val();
            loanAmountAfterDeduction = loanAmount - ((loanAmount * adminfee) / 100);
            var amount = parseFloat(rate) / 100 * parseFloat(loanAmount);
            var result = parseFloat(loanAmount) + parseFloat(amount);
            $("#txtTotalAmountDue").val(Math.round(result * 100) / 100);
            var deduction = $( "#txtPretermDeduction").val();
            result = parseFloat(loanAmountAfterDeduction) - parseFloat(deduction);
            $("#txtExactLoanAmountPerceived").val(Math.round(result * 100) / 100);
        }

    }
    function InsertPreterm()
    {

        //
        var LoanAmount = $("#txtLoanAmount").val();
        var InterestRate = $("#txtInterestRate").val();
        var TotalAmountDue = $("#txtTotalAmountDue").val();
        var PretermDeduction = $("#txtPretermDeduction").val();
        var ExtraLoanAmount = $("#txtExactLoanAmountPerceived").val();
        var MaturityDate = $("#txtMaturityDate").val().trim();
        var modalPreterm = document.getElementById('modalPreterm');
        var btnPretermSubmit = document.getElementById('btnPretermSubmit');
        var TermId = 0;
        var TermType = 0;
        var flag = 0;
        //
        var TermValue = $("#txtTerm_ValuePreterm").val();
        var _termData = $("#ddlTermName option:selected").val();
        console.log("_termData : " + _termData);
        if (_termData != -"1") {
            _termData = _termData.split('_');
            TermId = _termData[0];
            TermType = _termData[1];
        }
        console.log("TermId : " + TermId);
        console.log("TermType : " + TermType);
        if (LoanAmount == "") {
            $("#txtLoanAmount").val('');
            $("#txtLoanAmount").addClass('has-error');
            flag++;
        }
        if (MaturityDate == "") {
            //
            $("#txtMaturityDate").val('');
            $("#txtMaturityDate").addClass('has-error');
            flag++;
        }
        if (ExtraLoanAmount <= 0) {
            //
            $("#txtExactLoanAmountPerceived").addClass('has-error');
            flag++;
        }
        if (_termData == 'Select' ) {
            //
            $("#ddlTermName").val('Select');
            $("#ddlTermName").addClass('has-error');
            flag++;
        }
        if (flag > 0) {
            return false;
        }

        else
        {
            modalPreterm.style.display = "block";
            btnPretermSubmit.style.display = "none";
          $.ajax({
            data: { ApplicationNo: _ApplicationNo, LoanAmount: LoanAmount, InterestRate: InterestRate, TotalAmountDue: TotalAmountDue, PretermDeduction: PretermDeduction, MaturityDate: MaturityDate, TermValue: TermValue, TermId: TermId, TermType: TermType },
                async:false,
                url:'@Url.Action("AddPreterm", "Loanoverdue")',
                success:function(data)
                {
                    alert(data);
                    window.location.reload();
                    var url = '@Url.Action("LoanPaymentBucket", "Loanoverdue", new { area = "Collector" })';
                    window.location.href = url;
                },
              error: function (data) {
                  window.location.reload(1);
              }
            });
        }

    }
    function InsertReloan()
    {
        var LoanAmount = $("#txtLoanAmountReloan").val();
        var InterestRate = $("#txtInterestRateReloan").val();
        var TotalAmountDue = $("#txtTotalAmountDueReloan").val();
        var ReloanDeduction = $("#txtReloanDeduction").val();
        var MaturityDate = $("#txtMaturityDateReloan").val();
        var TermId = $("#ddlTermNameReloan option:selected").val();
        var TermValue = $("#txtTerm_ValueReloan").val();
        var OldApplicationNo = '@Model.applicationno';
        $.ajax({
            data: { ApplicationNo: _ApplicationNo, LoanAmount: LoanAmount, InterestRate: InterestRate, TotalAmountDue: TotalAmountDue, ReloanDeduction: ReloanDeduction, MaturityDate: MaturityDate, TermValue: TermValue, TermId: TermId },
                async:false,
                url:'@Url.Action("AddReloan", "Loanoverdue")',
                success:function(data)
                {

                    if (data) {
                        alert("Added successfull");
                        var url = '@Url.Action("PaymentHistory", "Loanoverdue")?Id=' + OldApplicationNo + '&ActionName=LoanDetail';;
                        window.location.href = url;

                    }
                    else {
                        alert("Unsuccessfull");
                    }

            },
            error: function (data) {
                window.location.reload(1);
            }
            });
    }
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
</script>
