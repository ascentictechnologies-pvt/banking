        <div class="modal-body" id="modalDefaultUser" style="padding-top: 4%;">
            <table class="table table-bordered table-striped" id="divDefaulter">
            </table>
            <div class="clearfix"></div>
        </div>
        <div class="modal-footer">
            <input type="button" class="btn btn-primary btn-flat" id="btnSetDefualter" value="Yes" />
            <input type="button" class="btn btn-primary btn-flat" value="No" onclick="$('#modalDefault').toggle();" />
        </div>
    </div>
</div>
@using (Html.BeginForm("PaymentHistory", "Loanoverdue", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div id="modalPreterm" class="modal" style="width:70%; padding-left:30%; padding-top:5%">
        <div class="modal-content">
            <div class="modal-header">
                <span class="close" onclick="RefreshPreTermModel()">&times;</span>
                <h3>Preterm</h3>
            </div>
            <div class="modal-body">
                <table class="table table-bordered table-striped">
                    <tr>
                        <td>
                            <label>Loan Amount</label>
                        </td>
                        <td>
                            <input type="number" name="LoanAmount" id="txtLoanAmount" onchange="CalculateTotalAmount()" class="form-control" onfocus="RemoveValidation(this);" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>Term</label>
                        </td>
                        <td>
                            <select class="form-control" onfocus="RemoveValidation(this);" name="TermName" id="ddlTermName" onchange=" GetDataAccToTerm()"><option value="-1">Select</option></select>
                            <input type="hidden" class="form-control" name="TermValue" id="txtTerm_ValuePreterm" readonly />
                            <input type="hidden" class="form-control" name="AdminFee" id="txtAdminFeePreterm" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>Interest Rate</label>
                        </td>
                        <td>
                            <input type="text" class="form-control" name="ApprovedInterestRate" id="txtInterestRate" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>Maturity Date</label>
                        </td>
                        <td>
                            <input type="date" name="MaturityDate" id="txtMaturityDate" onfocus="RemoveValidation(this);" class="form-control" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>Preterm Deduction</label>
                        </td>
                        <td>
                            <input type="number" name="PretermDeduction" id="txtPretermDeduction" class="form-control" readonly />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>Exact Loan Amount Perceived</label>
                        </td>
                        <td>
                            <input type="number" name="ExactLoanAmountPerceived" id="txtExactLoanAmountPerceived" onfocus="RemoveValidation(this);" class="form-control" min="1" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label>Total Amount Due</label>
                        </td>
                        <td>
                            <input type="number" name="TotalAmountDue" id="txtTotalAmountDue" class="form-control" readonly />
                        </td>
                    </tr>
                </table>



                <div class="clearfix"></div>
            </div>
            <div class="modal-footer">
                <input type="button" class="btn btn-primary btn-flat" id="btnPretermSubmit" value="Submit" onclick="InsertPreterm()" />
                <input type="button" class="btn btn-danger btn-flat" id="btnPretermCancel" value="Cancel" onclick="RefreshPreTermModel()" />
            </div>
        </div>
    </div>

    <div id="modalReloan" class="modal" style="width:70%; padding-left:30%; padding-top:5%">
        <div class="modal-content">
            <div class="modal-header">
                <span class="close" onclick="$('#modalReloan').toggle();">&times;</span>
                <h3>Reloan</h3>
            </div>
            <div class="modal-body">
                <div class="row form-group spc">
                    <div class="col-md-12">
                        <div class="col-md-6">
                            <label>Loan Amount</label>
                        </div>
                        <div class="col-md-6">
                            <input type="number" name="LoanAmount" id="txtLoanAmountReloan" onkeyup="CalculateReloan()" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row form-group spc">
                    <div class="col-md-12">
                        <div class="col-md-6">
                            <label>Term</label>
                        </div>
                        <div class="col-md-6">
                            <select class="form-control" name="TermName" id="ddlTermNameReloan" onchange="GetDataAccToTermReloan()"><option value="-1">Select</option></select>
                            <input type="hidden" class="form-control" name="ApprovedTerm" id="txtTerm_ValueReloan" readonly />
                        </div>
                    </div>
                </div>

                <div class="row form-group spc">
                    <div class="col-md-12">
                        <div class="col-md-6">
                            <label>Interest Rate</label>
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="ApprovedInterestRate" id="txtInterestRateReloan" readonly />
                        </div>
                    </div>
                </div>
                <div class="row form-group spc">
                    <div class="col-md-12">
                        <div class="col-md-6">
                            <label>Maturity Date</label>
                        </div>
                        <div class="col-md-6">
                            <input type="date" name="MaturityDate" id="txtMaturityDateReloan" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row form-group spc">
                    <div class="col-md-12">
                        <div class="col-md-6">
                            <label>Reloan Deduction</label>
                        </div>
                        <div class="col-md-6">
                            <input type="number" name="ReloanDeduction" id="txtReloanDeduction" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row form-group spc">
                    <div class="col-md-12">
                        <div class="col-md-6">
                            <label>Exact Loan Amount Perceived</label>
                        </div>
                        <div class="col-md-6">
                            <input type="number" name="ExactLoanAmountPerceived" id="txtExactLoanAmountPerceivedReloan" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row form-group spc">
                    <div class="col-md-12">
                        <div class="col-md-6">
                            <label>Total Amount Due</label>
                        </div>
                        <div class="col-md-6">
                            <input type="number" name="TotalAmountDue" id="txtTotalAmountDueReloan" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="modal-footer">
                <input type="button" class="btn btn-primary btn-flat" id="btnReloanSubmit" value="Submit" onclick="InsertReloan()" />
                <input type="button" class="btn btn-danger btn-flat" id="btnReloanCancel" value="Cancel" onclick="$('#modalReloan').toggle();" />
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <input type="button" class="btn btn-primary pull-right" id="btn_Back" value="Back" onclick="location.href='@Url.Action("LoanDetail","Loanoverdue")?Id=' + @Model.applicationno+ '&ActionName=@Request.QueryString["ActionName"]'" />
    </div>
    <div style="padding-top:2%;">
        <div class="col-md-12">
            @{
                if (Model.ReduceLoanCount == 0)
                {
                    <button type="button" class="btn btn-primary btn-flat" id="btn_ReduceLoan" onclick='ReduceLoan("@Model.applicationno")'>ReduceLoan</button>
                }
            }
            <button type="button" class="btn btn-primary btn-flat" id="btn_Disqualify" onclick='Disqualify("@Model.applicationno")'>Disqualify</button>
            <button type="button" class="btn btn-primary btn-flat" id="btn_Preterm" onclick='GetPreterm("@Model.applicationno ", "@Model.balanceamt")'>Preterm</button>

            <button type="button" class="btn btn-primary btn-flat" id="btn_Default" onclick='Default("@Model.applicationno")'>Default</button>
            <button type="button" class="btn btn-primary btn-flat" id="btn_VerificationWindow" onclick='VerificationWindow("@Model.applicationno")'>Verification Window</button>


        </div>
    </div>
    <div style="padding-top:2%;" class="col-md-12">
        <table class="table table-bordered table-striped">
            @{
                for (int i = 0; i < 5; i++)
                {
                    <tr>
                        @if (i == 0)
                        {
                            <th>@Model.Referenceno</th>
                        }
                        @if (i == 1)
                        {
                            <th>Due Date</th>
                        }
                        @if (i == 2)
                        {
                            <th>Ammortization</th>
                        }
                        @if (i == 3)
                        {
                            <th>Payment Date</th>
                        }
                        @if (i == 4)
                        {
                            <th>Amount Paid</th>
                        }
                        @{
                            int count = i + 1;
                            foreach (var item in Model.paymentinformation)
                            {
                                if (i == 0)
                                {
                                    <th>@count</th>
                                }
                                if (i == 1)
                                {
                                    <td>@item.Dueedate</td>
                                }
                                if (i == 2)
                                {
                                    <td>@item.amortization</td>
                                }
                                if (i == 3)
                                {
                                    if (Convert.ToDecimal(item.Paidamount) > 0)
                                    {
                                        <td>@item.paymentdate</td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                }
                                if (i == 4)
                                {
                                    <td>@item.Paidamount</td>
                                }
                                count = count + 1;
                            }
                        }
                    </tr>
                }
            }
        </table>
    </div>
}

<script type="text/javascript">
    $(document).ready(function () {

        $("#btnSetDefualter").click(function () {
            var Application_No=@Model.applicationno;
            var selectedVal = "";
            var userid = $("input[type='radio']:checked").val();
            var Msg = confirm("Do You want to Proceed?");
            if (Msg) {
                $.ajax({
                    url: '@Url.Action("DefaulterUser", "Loanoverdue")',
                    type: 'POST',
                    data: { application_no: Application_No, defaulteruser_id: userid},
                    success: function (data) {
                        if (data) {
                            alert("Data Successfully Inserted");
                            $('#modalDefault').toggle();
                            return true;
                        }
                        else {
                            alert("Data not updated");
                        $('#modalDefault').toggle();
                            return true;
                        }

                    },
                    error: function (data) {
                        window.location.reload(1);
                    }
                });
            }
            else {
                return false;
            }
        });
    });
    function RefreshPreTermModel() {
        window.location.reload();
    }
