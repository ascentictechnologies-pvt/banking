@using System.Configuration
@model Loan_CRM.Models.CompleteAppVerificationDetails

@{
    ViewBag.Title = "Verification Window";
    Layout = "~/Views/Shared/_LayoutVerifer.cshtml";
}
<style>
    #back2Top {
        width: 40px;
        line-height: 40px;
        overflow: hidden;
        z-index: 999;
        display: none;
        cursor: pointer;
        -moz-transform: rotate(270deg);
        -webkit-transform: rotate(270deg);
        -o-transform: rotate(270deg);
        -ms-transform: rotate(270deg);
        transform: rotate(270deg);
        position: fixed;
        bottom: 50px;
        right: 0;
        background-color: #DDD;
        color: #555;
        text-align: center;
        font-size: 30px;
        text-decoration: none;
    }

        #back2Top:hover {
            background-color: #DDF;
            color: #000;
        }
</style>

<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>

<div class="pull-left">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <td style="text-align:center">
                    <b style="font-size:20px;">Verification Window</b>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="pull-right">
    @Html.HiddenFor(x => x.userid)
    <input type="hidden" name="GovUrl" value="@Model.GovUrl" />
    <input type="hidden" name="CompUrl" value="@Model.CompUrl" />
    <input type="hidden" name="IncomeUrl" value="@Model.IncomeUrl" />
    <input type="hidden" name="BillUrl" value="@Model.BillUrl" />
    <input type="hidden" name="OthUrl" value="@Model.OthUrl" />
    <input type="hidden" name="ATMUrl" value="@Model.ATMUrl" />
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                @if (Model.ApplicationNo > 0)
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("GetSmileData", "Home", new { Area = "" })?ApplicationNo=@Model.ApplicationNo' title="Employment Details" target="_blank">Employment Details</a></td>
                }
                @if (!String.IsNullOrWhiteSpace(Model.PersonalEmail))
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("GetOldData", "Home", new { Area = "" })?Emailid=@Model.PersonalEmail' title="Offline Loan History" target="_blank">Offline Loan History</a></td>
                }
                @if (Model.ApplicationNo > 0)
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("LoanHistory", "Home", new { Area = "" })?UserID=@Model.userid&ActionName=@Request.QueryString["ActionName"]&ApplicationNo=@Model.ApplicationNo' title="Loan History" target="_blank">Loan History</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.GovUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="GovermentID Document missing!">ID1</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.GovUrl' title="GovermentID Document" target="_blank">ID1</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.CompUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Company Document missing!">ID2</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.CompUrl' title="Company Document" target="_blank">ID2</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.IncomeUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Income Document missing!">PI</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.IncomeUrl' title="Income Document" target="_blank">PI</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.BillUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Bill Document missing!">PB</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.BillUrl' title="Bill Document" target="_blank">PB</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.OthUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Other Document missing!">O</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.OthUrl' title="Other Document" target="_blank">O</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.ATMUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="ATM Document missing!">A</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" title="ATM Document" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.ATMUrl' target="_blank">A</a></td>
                }
                <td></td>
                <td><input type="button" id="btnBack" value="Back" class="btn btn-primary" onclick="UpdateIsPickedVerifier()" /></td>
            </tr>
        </tbody>
    </table>
</div>

<a id="back2Top" title="Back to top" href="#">&#10148;</a>

