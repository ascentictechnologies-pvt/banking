<link href="https://code.jquery.com/ui/1.10.2/themes/smoothness/jquery-ui.css" rel="Stylesheet" />
<script src="https://code.jquery.com/ui/1.10.2/jquery-ui.js"></script>
<script type="text/javascript">
    $(window).scroll(function () {
        var height = $(window).scrollTop();
        if (height > 100) {
            $('#back2Top').fadeIn();
        } else {
            $('#back2Top').fadeOut();
        }
    });

    function keypressHandler(e) {
        if (e.which == 13) {
            e.preventDefault(); //stops default action: submitting form
            $(this).blur();
            $('#SubmitButton').focus().click(); //give your submit an ID
        }
    };

    $('#frmApplication').keypress(keypressHandler);

    $(document).ready(function () {
        if ($("#ddlBank :selected").val() == "") {
            $("#BankAccNo").attr('readonly', 'readonly');
            $("#BankAccNo").val("");
        } else {
            $("#BankAccNo").removeAttr('readonly', 'readonly');
        }
        GetLastRemark();
        $("#btn_notification").click(function () {
            NotifyModal();
        });
        $("#btnNext").click(function () {
            var TermName = $("#ddlTermName :selected").val();
            var _Messag = "";
            if ($("#ddlBank :selected").val() == "") { }
            var ApprovedLoanAmount = ($("#ApprovedLoanAmount")).val();
            if (ApprovedLoanAmount == 0 || ApprovedLoanAmount == "") {
                _Messag += "Approved Loan Amount Missing\n";
                //alert('Approved Loan Amount Missing');
                //return false;
            }
            if ($("#ddlBank :selected").val() != "") {
                if ($("#BankAccNo").val() == "") {
                    _Messag += "Bank Name and Account No is Mandatory\n";
                    //alert("Bank Name and Account No is Mandatory");
                    $("#BankAccNo").addClass('has-error');
                    $('html,body').animate({
                        scrollTop: $("#BankAccNo").offset().top
                    }, 800);
                    //return false;
                }
            }
            if ($("#occupation :selected").val() == "") {
                $("#occupation").addClass('has-error');
                _Messag += "Company Industry is Mandatory\n";
                //alert("Company Industry is Mandatory");
                $('html,body').animate({
                    scrollTop: $("#occupation").offset().top
                }, 800);
                //return false;
            }
            if ($("#ddlBank :selected").val() == "") {
                $("#ddlBank").addClass('has-error');
                _Messag += "Bank Name is Mandatory\n";
                //alert("Bank Name is Mandatory");
                $('html,body').animate({
                    scrollTop: $("#BankAccNo").offset().top
                }, 800);
                //return false;
            }
            if (TermName == "-1" || TermName == undefined) {
                _Messag += "Approved Term not Selected\n";
                //alert("Approved Term not Selected");
                //return false;
            }
            if ($("#AdditionalLoanPurpose").val() == "") {
                _Messag += "Purpose of Loan Mandatory\n";
                //alert('Purpose of Loan Mandatory');
                //return false;
            }
            if (_Messag != "") {
                alert(_Messag);
                return false;
            }

            //Check the Duplicate Contract
            $.ajax({
                url: '@Url.Action("CheckDuplicateApplicationNo", "LoanRequestVerifier")',
                type: "POST",
                async: false,
                //dataType: "json",
                data: {
                    appno: @Model.ApplicationNo,
                },
                success: function (data) {
                    if (data === 'False') {
                        var _result = confirm("Are you sure to resend the new contract?");
                        if (_result == false) {
                            console.log(_result);
                            return false;
                        }
                    }
                }
            });
        });
        $("#back2Top").click(function (event) {
            event.preventDefault();
            $("html, body").animate({
                scrollTop: 0
            }, "slow");
            return false;
        });
        $("#personal_name_remark").focus();

        BindTermType();
        $(".form-control").focusin(function () {
            $(this).removeClass("has-error");
        });
        $("#btndecline").click(function (event) {
            window.location.href = '@Url.Action("UpdateReVerifyRequestDetail", "LoanRequestVerifier")?Id=@Model.ApplicationNo&user_id=@Model.userid&Actionname=@Convert.ToString(Session["_ActionName"])';
        });
        $("#txtCity").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Home/City",
                    type: "POST",
                    dataType: "json",
                    data: {
                        Prefix: request.term
                    },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return {
                                label: item.city,
                                value: item.city
                            };
                        }))
                    }
                })
            },
            messages: {
                noResults: "",
                results: ""
            }
        });
    });
    function NotifyModal() {
        var modalNotify = document.getElementById('modalNotify');
        modalNotify.style.display = "block";
    }
    function SendNotify() {
        debugger;
        $.ajax({
            type: 'POST',
            dataType: 'json',
            data: { notificationtoken: '@Model.notificationtoken', message: $("#txtnotifydefinition").val(), UserName: '@Convert.ToString(Request.Cookies["AgentName"].Value)', PanelName: '@Convert.ToString(Request.Cookies["RoleType"].Value)', MobileNo: '@Model.PersonalContactNo', ApplicationNo: '@Model.ApplicationNo' },
            url: '@Url.Action("SendManulNotification", "Home", new { Area = "" })',
            success: function (data)
            {
                if (data) {
                    alert("Notification Send Succussfully..");
                    $('#modalNotify').toggle();
                }
            }
        });
    };
    function GetNotificationValue() {
        var Id = $('#ddlNotificationtemplate').val();
        $.ajax({
            async: false,
            type: 'GET',
            url: '@Url.Action("GetNotificationValues", "LoanRequestBucket", new { area = "Checker" })',
            dataType: 'json',
            data: { Id: Id },
            success: function (sms) {
                if (sms != null) {
                    $("#txtnotifydefinition").val(sms.NotificationTemplateDefinition);
                    $("#txtnotifydescription").val(sms.NotificationTemplateDesc);
                }
            },
            error: function (data) {
                window.location.reload(1);

            }
        });
    };
    function RefreshNotifyModel() {
        $('#modalNotify').toggle();
        $("#ddlNotificationtemplate").val('');
        $("#txtnotifydefinition").val('');
        $("#txtnotifydescription").val('');
    }
    function CLicktocall(data) {
        $.ajax({
            async: false,
            type: 'GET',
            url: '@Url.Action("ClicktoCall", "LoanRequestVerifier", new { area = "Verifier" })',
            dataType: 'json',
            data: {
                ContactNumber: data
            },
            success: function (result) {
                console.log(result);
                if (result) {
                    availability = false;
                }
            },
            error: function (result) {
                window.location.reload(1);
            }
        });
    }

    function BindTermName() {
        var Amount = $("#ApprovedLoanAmount").val();
        $.ajax({
            url: "/LoanRequestVerifier/GetTermName",
            type: "POST",
            data: {
                Amount: Amount
            },
            success: function (data) {
                if (data != null) {
                    for (var i = 0; i < data.length; i++) {
                        var opt = new Option(data[i].term_Name, data[i].Id);
                        $('#ddlTermName').append(opt);
                    }
                } else {
                    window.location.reload(1);
                }
            },
            error: function (data) {
                console.log(data);
              //  window.location.reload(1);
            },
            complete: function (data) {
                $("#ddlTermName").val(@Model.TermName);
                GetDataAccToTerm();
            }
        });
    }

    function BindTermType() {
        $.ajax({
            url: "/LoanRequestVerifier/GetTermType",
            type: "POST",
            success: function (data) {
                if (data != null) {
