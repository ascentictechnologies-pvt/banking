    function GetDataAccToTerm() {
        var termId = $("#ddlTermName option:selected").val();
        if (termId != undefined) {
            $.ajax({
                url: '@Url.Action("GetDataAccToTerm", "LoanRequestVerifier")',
                type: "POST",
                data: {
                    id: termId
                },
                success: function (data) {
                    if (data != null) {
                        $("#txtTermType").val(data.TermTypeName);
                        $("#txtInterestRate").val(data.Rate);
                        $("#txtTerm_Value").val(data.term_Value);
                        $("#txtTerm_Id").val(data.approved_term);
                        if ($("#ApprovedLoanAmount").val() != 0) {
                            CalculateTotalAmount();
                        }
                    } else {
                        window.location.reload(1);
                    }
                },
                error: function (data) {
                    window.location.reload(1);
                }
            });
        }
    }

    function CalculateTotalAmount() {
        var loanAmount = $("#ApprovedLoanAmount").val().trim();
        if (loanAmount == '') {
            $("#ApprovedTotalDueAmount").val(0);
        } else {
            var rate = $("#txtInterestRate").val();
            var amount = parseFloat(rate) / 100 * parseFloat(loanAmount);
            var result = parseFloat(loanAmount) + parseFloat(amount);
            $("#ApprovedTotalDueAmount").val(Math.round(result * 100) / 100);
        }
    }

