    }

    function ValidateFile(e) {
        if (e != "" || e != null) {
            var IsValidExtension = false;
            var file = e;
            var fileSize = file.files[0].size;
            var isValidFile = false;
            IsValidExtension = CheckExtension(e);
            if (IsValidExtension) {
                if (fileSize !== 0 && fileSize <= (5 * 1024 * 1024)) {
                    isValidFile = true;
                } else if (!isValidFile) {
                    alert("File Size Should not exceed 5 MB");
                    var id = e.id;
                    $("#" + id).val('');
                }
            }
        } else {
            return false;
        }
    }

    function CheckExtension(e) {
        if (e != "") {
            var validFilesTypes = ["jpg", "png", "jpeg", "pdf"];
            var file = e;
            var path = file.value;
            var ext = path.substring(path.lastIndexOf(".") + 1, path.length).toLowerCase();
            var isValidFile = false;
            for (var i = 0; i < validFilesTypes.length; i++) {
                if (ext == validFilesTypes[i]) {
                    isValidFile = true;
                    break;
                }
            }
            if (!isValidFile) {
                alert("Upload Image types file only");
                var id = e.id;
                $("#" + id).val('');
            }
            return isValidFile;
        } else
            return false;
    }

