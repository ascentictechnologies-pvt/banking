@using System.Configuration;
@model Loan_CRM.Models.ApplicationRecordVM
@{
    ViewBag.Title = "Declined Application List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="panel panel-primary">
    <div class="panel-heading">
        <div class="row">
            <div class="col-md-12">
                <h5>Declined Application<input type="button" class="btn btn-danger btn-flat pull-right" value="Back" onclick="location.href='@Url.Action("AllRecordExport", "Admin") '" /></h5>
            </div>
        </div>
    </div>
    <div class="panel-body">
        <table id="tblDeclineApplication" class="data-verification table table-striped">
            <thead>
                <tr>
                    <th>Sr No.</th>
                    <th>Applicant No</th>
                    <th>Applicant Name</th>
                    <th>Remarks</th>
                    <th>Request Date</th>
                    <th>Delete</th>
                    <th>Resume</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        GetRecord();
    });
    function Requestdetail(obj, obj1) {
        var url = '@Url.Action("RequestDetail", "LoanRequestBucket",new { area="checker"})?Id=' + obj + '&phoneNumber=' + obj1 + '&Actionname=LoanRequest';
        window.location.href = url;
    }
    function GetRecord() {

        var table = $("#tblDeclineApplication").DataTable({
            "processing": true, // for show progress bar
            "serverSide": true,
            "filter": true,
            "orderMulti": false, // for disable multiple column at once
            "pageLength": 10,
            "lengthChange": true,
            "bInfo": false,
                "ajax": {
                    "url": '@Url.Action("GetDeclinedApplicationData", "Admin", new { Area = "Admin" })',
                    "type": "POST",
                    "datatype": "json",
                    error: function (data) {
                        console.log(`Error :` + data);
                    }
                },
            "columns": [
                { "data": "Id", "name": "Id" },
                { "data": "applicationno", "name": "applicationno" },
                { "data": "applicationname", "name": "applicationname" },
                { "data": "checker_remark", "name":"checker_remark"},
                { "data": "RequestDate", "name": "RequestDate"},
                {
                    "render": function (data, type, full, meta) {
                        return '<img src="../../../Content/images/Delete.png" style="width:18%;cursor:pointer;" onclick="DelecteDeclinedApplication(' + full.applicationno + ')">';
                    }
                },
                {
                    "render": function (data, type, full, meta) {
                        return '<img src="../../../Content/images/Resume.png" style="margin-left:3%;cursor:pointer;" onclick="ResumeDeclinedApplication(' + full.applicationno + ')">';
                    }
                }
            ]
        });
    }
    function DelecteDeclinedApplication(AppId)
    {
        $.ajax({
            data: { AppId: AppId },
            url: '@Url.Action("DeleteDuplicateRecord", "Admin")',
            success: function (data)
            {
                if (data) {
                    alert("Deleted Successfully");

                }
                window.location.href = '@Url.Action("DeclinedApplication", "Admin", new { area = "Admin"})';
            }
        });
    }
    function ResumeDeclinedApplication(AppId) {
        $.ajax({
            data: { AppId: AppId },
            url: '@Url.Action("ResumeDeclinedApplication", "Admin")',

            success: function (data) {
                if (data)
                {
                    alert("Resumed Successfully");

                }
                window.location.href = '@Url.Action("DeclinedApplication", "Admin" , new { area = "Admin"})';
            }
        });
    }
    function GetRecords(val) {

        var records = $("#ddlrecord option:selected").val();
        GetRecord(records);
    }
</script>

<style>
    .classname {
        position: absolute;
        z-index: 10;
        top: 300px;
        left: 600px;
    }
</style>





