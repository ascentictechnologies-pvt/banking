@model Loan_CRM.Models.BankMasterModelVM

@{
    ViewBag.Title = "BankMaster";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<style>
    .has-error {
        color: red !important;
    }
</style>
<h2></h2>
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="col-md-12">
    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Add Bank Details</span>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <input type="hidden" id="bank_id" name="bank_id" value="@Model.bank_id" />
                        <label>Bank Code</label>
                        @Html.TextBoxFor(x => x.bank_code, new { @class = "form-control", @maxlength = "20", @placeholder = "Bank Code", @style = "text-transform: uppercase", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.bank_code, null, new { @class = "has-error" })
                    </div>
                    <div class="form-group">
                        <label>Bank Name</label>
                        @Html.TextBoxFor(x => x.bank_name, new { @class = "form-control CharcaterTextBox", @placeholder = "Bank Name", @style = "text-transform: uppercase", @maxlength = "50", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.bank_name, null, new { @class = "has-error" })
                    </div>
                </div>
                <div class="panel-footer">
                    <div>
                        <input type="submit" id="btnSave" value="Save" class="btn btn-success" />
                        <input type="button" value="Reset" id="btnReset" class="btn btn-danger" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Bank Details</span>
                </div>
                <div class="panel-body">
                    <table id="tblBank" class="table table-striped table-responsive">
                        <thead>
                            <tr>
                                <th>SNO</th>
                                <th>Bank Code</th>
                                <th>Bank Name</th>
                                <th>Created On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model.BankMasterModelList != null && Model.BankMasterModelList.Count > 0)
                                {
                                    int i = 1;
                                    foreach (var item in Model.BankMasterModelList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.bank_code</td>
                                            <td>@item.bank_name</td>
                                            <td>@item.created_on</td>
                                            <td>
                                                <a style="cursor:pointer;" onclick="EditData('@item.bank_id')">Edit</a> | @{
                                                    if (item.is_active.HasValue == true && item.is_active.Value == true)
                                                    {
                                                        <a class="anchor" onclick="DisableData(@item.bank_id)" title="Click to Disable"><img src="~/Content/img/Circle_Green.png" alt="Enable" height="18" width="18" /></a>
                                                    }
                                                    else
                                                    {
                                                        <a class="anchor" onclick="EnableData(@item.bank_id)" title="Click to Enable"><img src="~/Content/img/Circle_Red.png" alt="Disable" height="18" width="18" /></a>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                        i = i + 1;
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#tblBank").DataTable();
        $("#btnReset").click(function () {
            $("#bank_id").val("0");
            $("#bank_code").val("");
            $("#bank_name").val("");
            $("#btnSave").val("Save");
        });
    });
    //Remove Validation
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
    $("#btnReset").click(function () {
        window.location.reload();
    });
    function EditData(Id) {

        $.ajax({
            url: '@Url.Action("EditBankData", "Admin",new { Area="Admin"})',
            type: "POST",
            data: { Id: Id },
            success: function (result) {
                if (result != null) {

                    $("#bank_id").val(result[0].bank_id);
                    $("#bank_code").val(result[0].bank_code);
                    $("#bank_name").val(result[0].bank_name);
                    $("#btnSave").val("Update");
                }
                else {
                    window.location.reload(1);
                }
            },
            error: function (data) {
                console.log(`Error :` + data);
            }
        });
    }
    function DisableData(id) {
            var r = confirm("Are you sure to Disable this Bank?");
            if (r == true) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DisableBank", "Admin",new { Area="Admin"})',
                        data: { id: id },
                        success: function (data) {
                            console.log(data);

                            if (data) {
                                window.location.href = '@Url.Action("BankMaster","Admin",new {Area="Admin"})';
                            }
                        }
                    });
            }
        }
        function EnableData(id) {
            var r = confirm("Are you sure to Enable this Bank?");
            if (r == true) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("EnableBank", "Admin",new { Area="Admin"})',
                    data: { id: id },
                    success: function (data) {
                        console.log(data);
                        if (data) {
                            window.location.href = '@Url.Action("BankMaster","Admin",new {Area="Admin"})';
                        }
                    }
                });
            }
        }
</script>
