                            <tr>
                                <th>Application No</th>
                                <th>Remark</th>
                                <th>Remark By</th>
                                <th>Remark On</th>
                            </tr>
                        </thead>
                        <tbody id="tblRemarkBody"></tbody>
                    </table>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 col-sm-6 col-lg-6 col-xs-6">
            <table border="1" class="table table-bordered table-responsive table-striped">
                <tr>
                    <td style="width:30%"> <label>Application No:-</label></td>
                    <td style="width:70%" colspan="2"> <span id="span_address">@Model.applicationno</span></td>
                </tr>
                <tr>
                    <td>
                        <label>Name:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_name">@Model.name</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Address:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_address">
                            @{
                                var _Address = String.Empty;
                                if (!String.IsNullOrWhiteSpace(Model.address))
                                {
                                    _Address += Model.address.ToUpper();
                                    _Address += ",";
                                }
                                if (!String.IsNullOrWhiteSpace(Model.street))
                                {
                                    _Address += Model.street.ToUpper();
                                    _Address += ",";
                                }
                                if (!String.IsNullOrWhiteSpace(Model.barangay_name))
                                {
                                    _Address += Model.barangay_name.ToUpper();
                                    _Address += ",";
                                }
                                if (!String.IsNullOrWhiteSpace(Model.cityname))
                                {
                                    _Address += Model.cityname.ToUpper();
                                    _Address += ",";
                                }
                                if (!String.IsNullOrWhiteSpace(Model.province_name))
                                {
                                    _Address += Model.province_name.ToUpper();
                                    _Address += ",";
                                }
                                if (!String.IsNullOrWhiteSpace(Model.zipcode))
                                {
                                    _Address += Model.zipcode.ToUpper();
                                }
                            }
                            @_Address

                        </span>
                    </td>


                </tr>
                <tr>
                    <td>
                        <label>Date of Birth:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_datofbirth">@Model.dateofbirth</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Age:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_age">@Model.age</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Gender:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_age">@Model.gender</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Contact NO 1:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_contactone" style="overflow-wrap:break-word">@Model.personalcontactno</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Alternate No:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_homephoneno" style="overflow-wrap:break-word">@Model.homephoneno</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Personal Email Address:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_email">@Model.personalemail</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Employer Name:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_employername">@Model.companyname</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Employer Address:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_employraddress">@Model.companyaddress.ToUpper()</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Employer Contact No.:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_employercontectno" style="overflow-wrap:break-word">@Model.company_phoneno</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Current Position handle:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_posision">@Model.designation</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Date Hired:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_datehired">@Model.date_joining</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>SSS no./GSIS no./TIN no.:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_grossincome">@Model.sss_no</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Doc Type:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_doctype">@Model.gov_doc_type</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Pay Date 1:-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_paydate">@Model.paydate1</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Pay Date 2:-</label>
                    </td>
                    <td colspan="2">
                        @if (Model.paydate2 == 32)
                        {
                            <span id="span_paydate">None</span>
                        }
                        else
                        {
                            <span id="span_paydate">@Model.paydate2</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Facemap ID :-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_Jumio">@Model.jumioreference</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Transaction ID :-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_Jumio">@Model.transactionid</span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Document Status :-</label>
                    </td>
                    <td colspan="2">
                        <span id="span_facemap">@Model.facemapstatus</span>
                    </td>
                </tr>

                <tr>
                    <td>
                        <label>Add Contact No:-</label>
                    </td>
                    <td>
                        <select id="ddlMobileExtension" class="form-control col-md-4 mixselect">
                            <option value="09">09</option>
                            <option value="08">08</option>
                        </select>
                        @Html.TextBoxFor(x => x.add_personalcontactno, new { id = "txtcontactno", placeholder = "XXXXXXXXXXX", @class = "form-control NumericTextBox mixinput", maxlength = "9", @onfocus = "RemoveValidation(this);" })
                    </td>
                    <td>
                        <input type="button" onclick="AddPersonalContact();" class="btn btn-primary btn-flat btn-sm" value="Add" />
                    </td>
                </tr>
                <tr>
                    <td>
                        <label>Add Employer Contact No:-</label>
                    </td>
                    <td>
                        <select id="ddlCompanyMobileExtension" class="form-control col-md-4 mixselect">
                            <option value="09">09</option>
                            <option value="08">08</option>
                        </select>
                        @Html.TextBoxFor(x => x.add_company_phoneno, new { id = "txtemployercontactno", placeholder = "XXXXXXXXXXX", @class = "form-control NumericTextBox mixinput", maxlength = "9", @onfocus = "RemoveValidation(this);" })
                    </td>
                    <td>
                        <input type="button" onclick="AddCompanyPhoneNo();" class="btn btn-primary btn-flat btn-sm" value="Add" />
                    </td>
                </tr>
            </table>
        </div>
        <div class="col-md-6 col-sm-6 col-lg-6 col-xs-6">
            <table border="1" class="table table-bordered table-responsive table-striped">
                <tr>
                    <td></td>
                    <td><label>Credit Score</label></td>
                    <td></td>
                    <td><label>Default Probability</label></td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>@Model.CredoModel.Score</td>
                    <td>1</td>
                    <td>@Model.CredoModel.Probability</td>
                </tr>
            </table>
            <table border="1" class="table table-bordered table-responsive table-striped">
                <tr>

                    <td><label>Attach Gov't ID</label></td>
                    <td><label>Attach Company ID</label></td>
                </tr>
                <tr>
                    <td>
                        <input type="file" id="govid" name="GovIdFile" onchange="return ValidateFile(this);" />
                        <span style="color: #ff0000;">*Max size 5 MB , jpg,png,jpeg or pdf</span>
                    </td>
                    <td>
                        <input type="file" id="companyid" name="CompanyIdFile" onchange="return ValidateFile(this);" />
                        <span style="color: #ff0000;">*Max size 5 MB , jpg,png,jpeg or pdf</span>
                    </td>
                </tr>
            </table>
            <table border="1" class="table table-bordered table-responsive table-striped">
                <tr>
                    <td><label>Attach Proof of Billing</label></td>
                    <td><label>Attach Proof of Income</label></td>
                </tr>
                <tr>
                    <td>
                        <input type="file" id="billing" name="BillingIdFile" onchange="return ValidateFile(this);" />
                        <span style="color: #ff0000;">*Max size 5 MB , jpg,png,jpeg or pdf</span>
                    </td>
                    <td>
                        <input type="file" id="income" name="IncomeIdFile" onchange="return ValidateFile(this);" />
                        <span style="color: #ff0000;">*Max size 5 MB , jpg,png,jpeg or pdf</span>
                    </td>
                </tr>
            </table>
            <table border="1" class="table table-bordered table-responsive table-striped">
                <tr>
                    <td><label>Attach Other File</label></td>
                    <td><label>Attach ATM Card Image File</label></td>
                </tr>
                <tr>
                    <td>
                        <input type="file" id="otherfile" name="OtherIdFile" onchange="return ValidateFile(this);" />
                        <span style="color: #ff0000;">*Max size 5 MB , jpg,png,jpeg or pdf</span>
                    </td>
                    <td>
                        <input type="file" id="atm" name="AtmIdFile" onchange="return ValidateFile(this);" />
                        <span style="color: #ff0000;">*Max size 5 MB , jpg,png,jpeg or pdf</span>
                    </td>
                </tr>
                <tr>
                    <td colspan="2"><input type="submit" class="btn btn-primary pull-right" name="CommandName" value="Save Upload Files" /></td>
                </tr>
            </table>
            <table border="1" class="table table-bordered table-responsive table-striped">
                <tr>
                    <td colspan="2"><label>Enter Remark</label></td>
                </tr>
                <tr>
                    <td rowspan="2">
                        @Html.TextAreaFor(x => x.remarks, new { id = "txt_Remark", @class = "form-control", style = "height:119px;", onfocus = "RemoveValidation(this);" })
                    </td>
                    <td><input type="button" id="btn_RemarkSave" value="Save Remarks" class="btn btn-primary" /></td>
                </tr>
                <tr>
                    <td><input type="button" id="myBtn" value="Remark History" onclick="GetRemarks();" class="btn btn-primary" style="" /></td>
                </tr>
            </table>
            <table border="1" class="table table-bordered table-responsive table-striped">
                <tr>
                    <td><button type="button" style="margin-left: 1.3%;" class="btn btn-primary btn-flat" id="bth_Back">BACK</button></td>
                    <td><input type="submit" class="btn btn-primary btn-flat" name="CommandName" id="next_btn" value="NEXT"></td>
                    <td><button type="button" class="btn btn-primary btn-flat" id="call_btn">FOR CALL</button></td>
                    <td><button type="button" class="btn btn-primary btn-flat" id="btn_notification">Manual Notify</button></td>
                    <td>
                        <button type="button" class="btn btn-primary btn-flat" id="decline_btn">DECLINE</button>
                        @ViewBag.Name
                        @if (Convert.ToString(TempData["actionname"]) == "InsufficientDocument")
                        {
                            <text>
                                <script type="text/javascript">
                                    $("#insufficient_Doc_btn").hide();
                                </script>
                            </text>
                        }
                    </td>
                </tr>
            </table>
        </div>
    </div>

}
<script type="text/javascript">
    $(document).ready(function () {
        var modal = document.getElementById('myModal');
        var span = document.getElementsByClassName("close").onclick = function () {
            debugger;
            modal.style.display = "none";
        };
        span.onclick = function () {
            debugger;
            modal.style.display = "none";
        }
        window.onclick = function (event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        };
        $("#insufficient_Doc_btn").click(function () {
            var ApplicationId = '';
            ApplicationId = @Model.applicationno;
            var Name = '@Model.name';
            var number = "@Model.personalcontactno";
            var final = number.split(',');
            var count = parseInt(final.length);
            var phoneno = final[count - 1];
            if (ApplicationId != '') {
                $.ajax({
                    data: { ApplicationId: ApplicationId, ContactNo: phoneno, Name: Name, Email: '@Model.personalemail' },
                    url: '@Url.Action("UpdateInsufficientDoc", "LoanRequestBucket")',
                    success: function (data) {
                        if (data) {
                            alert("Record Updated Succussfully..");
                            window.location.href = '@Url.Action(Request.QueryString["Actionname"], "LoanRequestBucket")';
                        }
                        else {
                            window.location.reload(1);
                        }
                    }
                });
            }
        });
        $("#bth_Back").click(function () {
            var ApplicationId =@Model.applicationno;
            $.ajax({
                data:{ApplicationId:ApplicationId},
                url:'@Url.Action("UpdateIsPickedChecker", "LoanRequestBucket")',
                success:function(data)
                {
                    if (data)
                    {
                        window.location.href='@Url.Action(Request.QueryString["Actionname"], "LoanRequestBucket")';
                    }
                    else
                    {
                        window.location.reload(1);
                    }
                }
            });
        });
        $("#btn_RemarkSave").click(function () {
            var Remark = $("#txt_Remark").val().trim();
            var flag = true;
            if(Remark=="")
            {
                $("#txt_Remark").addClass('has-error');
                flag=false;
            }
            if(flag==true)
            {
                var ApplicationId=@Model.applicationno;
                $.ajax({
                    data:{ApplicationId:ApplicationId,Remark:Remark},
                    url:'@Url.Action("InsertRemark", "LoanRequestBucket")',
                    success:function(data)
                    {
                        if (data)
                        {
                            $("#txt_Remark").val('');
                            alert("Remark Inserted Successfully");
                        }
                    }
                });
            }
        });
        $("#call_btn").click(function () {
            var number = "@Model.personalcontactno";
            var final = number.split(',');
            var count = parseInt(final.length);
            var phoneno = final[count-1];
            $.ajax({
                async: false,
                type: 'GET',
                url: '@Url.Action("ClicktoCall", "LoanRequestBucket", new { area = "Checker" })',
                dataType: 'json',
                data: { ContactNumber: phoneno, userid: @Model.user_id, applicationno: @Model.applicationno },
                success: function (result) {
                    console.log(result);
                    if (result) {
                        availability = false;
                    }
                    else {
                        window.location.reload(1);
                    }
                }
            });
        });
        $("#next_btn").click(function (event) {
            var Remark = $("#txt_Remark").val().trim();
            if (Remark != "") {
                var ApplicationId =@Model.applicationno;
                $.ajax({
                    data: { ApplicationId: ApplicationId, Remark: Remark },
                    url: '@Url.Action("InsertRemark", "LoanRequestBucket")',
                    success: function (data)
                    {
                        if (data)
                        {
                            $("#txt_Remark").val('');
                            alert("Remark Inserted Successfully");
                        }
                    }
                });
            }

            var url = '@Url.Action("UpdateRequestDetail", "LoanRequestBucket")?Id=@Model.applicationno&phoneNumber=@Request.QueryString["phoneNumber"]&Actionname=@Request.QueryString["Actionname"]';
            window.location.href = url;
        });
        $("#decline_btn").click(function () {

            var number = "@Model.personalcontactno";
            var remarks = $("#txt_Remark").val().trim();
            if (remarks != "") {
                var final = number.split(',');
                var count = parseInt(final.length);
                var phoneno = final[count - 1];
                $.ajax({
                    data: { Id:@Model.applicationno, ContactNo: phoneno, Remaks: remarks, userid:@Model.user_id},
                    async: false,
                    url: '@Url.Action("UpdateDecline", "LoanRequestBucket")',
                    success: function (data) {
                        if (data) {
                            alert("Successfully Decline");
                            window.location.href = '@Url.Action("LoanRequest", "LoanRequestBucket")';
                        }
                        else
                            window.location.reload(1);
                    }
                });

                var url = '@Url.Action("LoanRequest", "LoanRequestBucket")';
                window.location.href = url;
            }
            else {
                alert("Remark is Manatory for Application Decline");
            }
        });
        $("#btn_notification").click(function () {
            NotifyModal();
        });
    });
    function ValidateFile(e) {

        if (e != "" || e != null) {
            var IsValidExtension = false;
            var file = e;
            var fileSize = file.files[0].size;
            var isValidFile = false;
            IsValidExtension = CheckExtension(e);
            if (IsValidExtension) {
                if (fileSize !== 0 && fileSize <= (5 * 1024 * 1024)) {
                    isValidFile = true;
                }
                else if (!isValidFile) {
                    alert("File Size Should not exceed 5 MB");
                    var id = e.id;
                    $("#" + id).val('');
                }
            }
        }
        else
            return false;
    };
    function CheckExtension(e) {
        if (e != "") {
            var validFilesTypes = ["jpg","png", "jpeg", "pdf"];
            var file = e;
            var path = file.value;
            var ext = path.substring(path.lastIndexOf(".") + 1, path.length).toLowerCase();
            var isValidFile = false;
            for (var i = 0; i < validFilesTypes.length; i++) {
                if (ext == validFilesTypes[i]) {
                    isValidFile = true;
                    break;
                }
            }
            if (!isValidFile) {
                alert("Upload Image types file only");
                var id = e.id;
                $("#" + id).val('');
            }
            return isValidFile;
        }
        else
            return false;
    };
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    };
