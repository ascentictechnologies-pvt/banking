@model Loan_CRM.Models.ApplicationRecordVM

@{
    ViewBag.Title = "UserLogin";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
@using (Html.BeginForm())
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12 banner-form">
            </div>
        </div>
        <div class="row " id="form-wizard">
            <div class="col-md-8 center-block col-float-none form-bg form-bg-bottom">
                <h2 class="text-center" style="font-size:27px">Forgot Your Password?</h2>

                <h5 class="text-contrast text-center text-bg-green padding-small col-md-12 center-block" style="float:none">Please enter your username or email address. <br />You will receive a link to create a new password via email.</h5>

                <div class="form-wrap" style="margin-top: 20px;">
                    <div class="row">
                        <div class="col-md-10 center-block" style="float:none;">
                            <div class="form-group">
                                <div id="msgdiv"></div>
                                @if (ViewData["Result"] != null)
                                {
                                    <script type="text/javascript">
                                            $("#msgdiv").show();
                                            $("#msgdiv").html("<div class='alert alert-danger' style='background-color: #dd4b39;color:white;'>" +@ViewData["Result"].ToString() +"</div>");
                                    </script>
                                }
                                <input type="text" name="PersonalEmail" placeholder="Email Address or Username" class="form-control input-lg" id="txtUserName" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-10 center-block" style="float:none;">
                            <input type="button" class="submit-btn col-md-12" id="btnSubmit" value="Get Password" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script type="text/javascript">
    function runEffect() {
        $("#msgdiv").fadeOut(), 300;
    }
    $(document).ready(function () {
        $("#btnSubmit").click(function () {

            var flag = true;
            var UserName = $("#txtUserName").val().trim();
            if (UserName == '') {
                $("#txtUserName").addClass('has-error');
                flag = false;
            }
            else {

                $.ajax({
                    data: { Email: UserName },
                    url: '@Url.Action("ForGotPasswordMethod","Home")',
                    success: function (data) {
                        if (data) {
                            $("#btnSubmit").hide();
                            alert("Password Reset link been sent on your Email Id");
                            window.location = '@Url.Action("UserLogin","Home")';
                        }
                        else {
                            $("#msgdiv").show();
                            $("#msgdiv").html("<div class='alert alert-danger' style='background-color: #dd4b39;color:white;'>Invalid E-Mail Id.</div>");
                        }
                    }

                });
            }
            return flag;
        });
        $("#txtUserName").focusin(function () {
            $("#txtUserName").removeClass('has-error');
            runEffect();
        });
    });
</script>

<style>
    .has-error {
        border-color: red;
        color: red;
    }
</style>