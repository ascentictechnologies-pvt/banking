@using System.Configuration;
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    @Scripts.Render("~/bundle/datepicker")
    @Styles.Render("~/Content/Datepicker")
    @Scripts.Render("~/bundles/jqueryTimer")
    @Styles.Render("~/Content/NewDesign")

    @Scripts.Render("~/Content/SweetAlertjs")
    @Styles.Render("~/Content/SweetAlertcss")
</head>
<body class="login-page">
    <div class="container-fluid">
        <div> @RenderBody()</div>


        <div class="clearfix"></div>
        <hr />
        <footer class="main-footer">
            <div class="pull-left">
                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <td style="text-align:center">
                                <strong>Copyright &copy; @DateTime.Now.Year <a href="https://cashmart.ph/">Cashmart </a>.</strong> All rights
                                reserved.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="pull-right">
                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <td><a href="#"><strong>Version :-4.0.2.8 (10 Jun, 2024)</strong></a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </footer>
    </div>
    <script type="text/javascript">
        @RenderSection("scripts", required: false)
    </script>
    @Scripts.Render("~/bundles/js")
</body>
</html>
