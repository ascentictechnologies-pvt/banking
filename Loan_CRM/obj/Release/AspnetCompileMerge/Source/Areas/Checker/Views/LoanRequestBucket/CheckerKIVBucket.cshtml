@using System.Configuration;
@{
    ViewBag.Title = "Checker KIV Bucket";
    Layout = "~/Views/Shared/_LayoutChecker.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
@using (Html.BeginForm())
{
    <div class="row">
        <div class="pull-left">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <td style="text-align:center">
                            <b style="font-size:20px;">Loan Request Checker Bucket(KIV)</b>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="pull-right">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <td style="text-align:center">
                            <input type="button" value="Back" class="btn btn-primary" onclick="location.href='@Url.Action("LoanRequest", "LoanRequestBucket")'" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

<table id="tblCheckerKIV" class="table table-bordered dataTable no-footer">
    <thead>
        <tr>
            <th>Applicant No</th>
            <th>Applicant Name</th>
            <th>Request Date</th>
            <th>Best Call Morning</th>
            <th>Best Call Noon</th>
            <th>Action</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
</table>

<script type="text/javascript">

    $(document).ready(function () {
        GetData();
    });

    function GetData() {
        var table = $("#tblCheckerKIV").DataTable({
            "processing": true, // for show progress bar
            "serverSide": true,
            "filter": true,
            "orderMulti": false, // for disable multiple column at once
            "pageLength": 10,
            "lengthChange": true,
            "bInfo": false,
            "ajax": {
                "url": '@Url.Action("GetKIVBucketData", "LoanRequestBucket", new { Area = "Checker" })',
                "type": "POST",
                "data": {"userid":@Request.Cookies[Loan_CRM.Models.CookiesKey.UserId].Value },
                "datatype": "json",
                error: function (data) {
                    //window.location.reload(1);
                }
            },
            "columns": [
                { "data": "applicationno", "name": "applicationno" },
                { "data": "applicationname", "name": "applicationname" },
                { "data": "RequestDate", "name": "RequestDate" },
                { "data": "MorningTime", "name": "MorningTime" },
                { "data": "NoonTime", "name": "NoonTime" },
                {
                    "render": function (data, type, full, meta) {
                        if (full.ispickedchecker == true) {
                            return '<span style="color:red;">In Process...</span>';
                        }
                        else {
                            return '<input type="button" value="Detail" class="btn btn-primary" id="btnDetail" onclick="Requestdetail(\'' + full.applicationno + '\', \'' + full.personalcontactno + '\')"/>';
                        }
                    }
                },
                {
                    "render": function (data, type, full, meta) {
                        if (full.term != 0) {
                            return '<img src="../../Content/img/Circle_Green.png" style="margin-left: 8%;"/>';
                        }
                        else {
                            return '<img src="../../Content/img/Circle_Yellow.png" style="margin-left: 8%;"/>';
                        }
                    }
                },
                {
                    "render": function (data, type, full, meta) {
                        if (full.companyid_url != '' && full.gov_id_url != '' && full.billing_url != '' && full.income_url != '') {
                            return '<img src="../../Content/img/Circle_Green.png" style="margin-left: 8%;"/>';
                        }
                        else {
                            return '<img src="../../Content/img/Circle_Yellow.png" style="margin-left: 8%;"/>';
                        }
                    }
                }
            ]
        });
        setInterval(function () { table.ajax.reload(); }, @Convert.ToInt32(ConfigurationManager.AppSettings["GridRefreshTime"]));
    }
