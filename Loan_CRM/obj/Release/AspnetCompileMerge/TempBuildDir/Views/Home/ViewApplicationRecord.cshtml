@model Loan_CRM.Models.ApplicationRecordVM
@{
    ViewBag.Title = "ViewApplicationRecord";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>

<div class="row" id="form-wizard">
    @using (Html.BeginForm("ViewApplicationRecord", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="row">
            <div class="col-md-12 banner-form">
            </div>
        </div>
        <div id="divMsg">

        </div>
        <div class="col-md-10 center-block col-float-none form-bg form-bg-bottom">
            @if (Convert.ToString(ViewData["NoRecordMsg"]) == "Record Found")
            {
                <div id="msgdiv"></div>
                if (TempData["Result"] != null)
                {
                    <text>
                        <script type="text/javascript">
                $("#msgdiv").show();
                $("#msgdiv").html("<div class='alert alert-danger' style='background-color: green;color:white;'>@Convert.ToString(TempData["Result"])</div>");
                        </script>
                    </text>
                }
                <div class="row">
                    <a class="btn btn-primary" style="float:right;color: white;" href="@Url.Action("LogOut", "Home")">Log Out</a>
                </div>

                if (ViewBag.noneditable)
                {
                    <h2 class="text-center" style="font-size:27px">View Your Personal Information</h2>
                }
                else
                {
                    <h2 class="text-center" style="font-size:27px">Update Your Personal Information</h2>
                }


                <p class="text-center" style="margin-bottom:30px; margin-top:20px;"><span><img src="../../Content/img/secure-loan.png" style="width: 15px; margin-right: 10px;"></span>Cash Mart uses 256-bit verified encryption to keep your data safe.</p>

                <div class="form-wrap row">
                    <div class="form-wrapper-group">
                        <div class="col-md-12">
                            <h4 class="text-contrast form-label">Personal Information</h4>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>FIRST NAME</label>
                                    <input type="text" id="txtFirstname" name="First_Name" class="form-control CharcaterTextBox" placeholder="FIRST NAME" value="@Model.First_Name" style="text-transform:uppercase" onfocus="RemoveValidation(this);" maxlength="50" disabled="disabled" readonly="@ViewBag.noneditable" />
                                    @Html.ValidationMessageFor(x => x.First_Name, null, new { @class = "has-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast">MIDDLE NAME</label>
                                    <input type="text" id="txtMiddlename" name="Middle_Name" class="form-control CharcaterTextBox" placeholder="MIDDLE NAME" value="@Model.Middle_Name" style="text-transform:uppercase" onfocus="RemoveValidation(this);" maxlength="50" disabled="disabled" readonly="@ViewBag.noneditable" />
                                    @Html.ValidationMessageFor(x => x.Middle_Name, null, new { @class = "has-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>LAST NAME</label>
                                    <input type="text" id="txtLastname" name="Last_Name" class="form-control CharcaterTextBox" placeholder="LAST NAME" value="@Model.Last_Name" style="text-transform:uppercase" onfocus="RemoveValidation(this);" maxlength="50" disabled="disabled" readonly="@ViewBag.noneditable" />
                                    @Html.ValidationMessageFor(x => x.Last_Name, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Email Address</label>
                                    <input type="text" id="txtpersonalemail" name="PersonalEmail" class="form-control EmailTextBox" placeholder="Email Address" disabled="disabled" onfocus="RemoveValidation(this);" value="@Model.PersonalEmail" maxlength="50" />
                                    <input type="hidden" value="texens" id="hdnpersonalmail" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Mobile Phone No and Contact No.</label>
                                    <input type="text" id="txtcontactno" name="PersonalContactNo" class="form-control NumericTextBox" placeholder="Mobile Phone No and Contact No." onfocus="RemoveValidation(this);" value="@Model.PersonalContactNo" maxlength="11" disabled="disabled" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Province</label>
                                    <input type="text" id="txtProvince" name="Province" class="form-control" placeholder="Province" onfocus="RemoveValidation(this);" value="@Model.Province" maxlength="100" readonly="@ViewBag.noneditable" />
                                    @Html.HiddenFor(x => x.province_id, new { @id = "province_id", @name = "province_id" })
                                    @Html.ValidationMessageFor(x => x.Province, null, new { @class = "has-error", @id = "province_idValid", })
                                    <label class="has-error" id="txtProvince_lbl"></label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Municipality or City</label>
                                    <input type="text" id="txtCity" name="City_Name" class="form-control CharcaterTextBox" placeholder="Municipality or City" onfocus="RemoveValidation(this);" value="@Model.City_Name" maxlength="50" />
                                    @Html.HiddenFor(x => x.City, new { @id = "txtcityId", @name = "City" })
                                    @Html.ValidationMessageFor(x => x.City_Name, null, new { @class = "has-error" })
                                    <label class="has-error" id="txtCity_lbl"></label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Barangay</label>
                                    <input type="text" id="txtBarangay" name="Barangay" class="form-control" placeholder="Barangay" onfocus="RemoveValidation(this);" value="@Model.Barangay" maxlength="100" readonly="@ViewBag.noneditable" />
                                    @Html.HiddenFor(x => x.Barangay_id, new { @id = "txtBarangay_id", @name = "Barangay_id" })
                                    @Html.ValidationMessageFor(x => x.Barangay, null, new { @class = "has-error" })
                                    <label class="has-error" id="txtBarangay_lbl"></label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Complete Address</label>
                                    <input type="text" id="txtAddress" name="Address" class="form-control" placeholder="House #/ Apartment #/ Floor/Condo Unit/Blk, Lot, Phase, SubdivisionName/ Compound/ Street" onfocus="RemoveValidation(this);" value="@Model.Address" maxlength="100" readonly="@ViewBag.noneditable" />
                                    @Html.ValidationMessageFor(x => x.Address, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Date of Birth </label>
                                    <input type="text" id="txtdateofbirth" class="form-control" placeholder="dd-mm-yyyy" name="DOB" onfocus="RemoveValidation(this);" value="@Model.DOB" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Civil Status</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(Model => Model.CivilStatus, new SelectList(ViewBag.CivilStatusData, "civilid", "civilname"), new { @class = "form-control", @id = "ddlcivilstatus", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(Model => Model.CivilStatus, new SelectList(ViewBag.CivilStatusData, "civilid", "civilname"), new { @class = "form-control", @id = "ddlcivilstatus", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>SSS No </label>
                                    <input type="text" id="txtSSS" class="form-control NumericTextBox" placeholder="SSS No" name="SSS_No" onfocus="RemoveValidation(this);" value="@Model.SSS_No" maxlength="10" readonly="@ViewBag.noneditable" />
                                    @Html.ValidationMessageFor(x => x.SSS_No, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <div class="col-md-12">
                            <h4 class="text-contrast form-label">Employment Details</h4>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Company/Business Name/Source of Income</label>
                                    <input type="text" id="txtcompanyname" class="form-control" placeholder="Name" name="CompanyName" onfocus="RemoveValidation(this);" value="@Model.CompanyName" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Company Address</label>
                                    <input type="text" id="txtcompanybranchaddress" class="form-control" placeholder="Address" onfocus="RemoveValidation(this);" name="CompanyAddress" value="@Model.CompanyAddress" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Company Phone No</label>
                                    <input type="text" id="txtcompanyphone" class="form-control NumericTextBox" placeholder="Company Phone No" maxlength="11" onfocus="RemoveValidation(this);" name="Company_Phoneno" value="@Model.Company_Phoneno" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Joining Date</label>
                                    <input type="text" id="txtjoiningdate" onfocus="RemoveValidation(this);" class="form-control" placeholder="dd-mm-yyyy" name="JoinDate" value="@Model.JoinDate" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Industry</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(x => x.Occupation, new SelectList(ViewBag.OccupationData, "id", "occupation_name", "optionGroup", Model.Occupation), new { @id = "ddlIndustry", @class = "form-control", @style = "width: 60%;", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(x => x.Occupation, new SelectList(ViewBag.OccupationData, "id", "occupation_name", "optionGroup", Model.Occupation), new { @id = "ddlIndustry", @class = "form-control", @style = "width: 60%;", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Position in the Company</label>
                                    <input type="text" id="txtposition" class="form-control CharcaterTextBox" placeholder="Position in your Company" name="Designation" value="@Model.Designation" readonly="@ViewBag.noneditable" onfocus="RemoveValidation(this);" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Gross Monthly Income</label>
                                    <input type="text" id="txtgrossmonthlyincome" class="form-control NumericTextBox" placeholder="Gross Monthly Income" onfocus="RemoveValidation(this);" name="GrossIncome" value="@Model.GrossIncome" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Pay Date 1</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(x => x.PayDate1, new SelectList(Model.PayDateList, "Value", "Text"), new { @id = "ddlPayDate1", @class = "form-control", @style = "width: 60%;", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(x => x.PayDate1, new SelectList(Model.PayDateList, "Value", "Text"), new { @id = "ddlPayDate1", @class = "form-control", @style = "width: 60%;", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Pay Date 2</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(x => x.PayDate2, new SelectList(Model.PayDate2List, "Value", "Text"), new { @id = "ddlPayDate2", @class = "form-control", @style = "width: 60%;", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(x => x.PayDate2, new SelectList(Model.PayDate2List, "Value", "Text"), new { @id = "ddlPayDate2", @class = "form-control", @style = "width: 60%;", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <div class="col-md-12">
                            <h4 class="text-contrast form-label">Loan Details</h4>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Loan Amount</label>
                                    <input type="text" id="txtloanamount" name="Loan_Amount" class="form-control NumericTextBox" placeholder="Loan Amount" onfocus="RemoveValidation(this);" value="@Model.Loan_Amount" readonly="@ViewBag.noneditable" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Term Type</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(Model => Model.TermType, new SelectList(ViewBag.TermTypeDate, "Id", "term_Type"), new { @class = "form-control", @id = "ddltermtype", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(Model => Model.TermType, new SelectList(ViewBag.TermTypeDate, "Id", "term_Type"), new { @class = "form-control", @id = "ddltermtype", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Terms</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(Model => Model.TermText, new SelectList(string.Empty, "Id", "term_Name"), "Select", new { @class = "form-control", @id = "ddlterm", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(Model => Model.TermText, new SelectList(string.Empty, "Id", "term_Name"), "Select", new { @class = "form-control", @id = "ddlterm", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="text-contrast"><span class="required-fields">*</span>Best Time to Call</label>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4 col-sm-6">
                                <div class="form-group">
                                    <label class="text-contrast text-center center-block">Morning</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(x => x.BestTimeToCallMorning_Id, new SelectList(Model.BestTimeToCallMorning, "Value", "Text"), new { @id = "ddl_BestTimeToCallMorning", @class = "form-control", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(x => x.BestTimeToCallMorning_Id, new SelectList(Model.BestTimeToCallMorning, "Value", "Text"), new { @id = "ddl_BestTimeToCallMorning", @class = "form-control", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6">
                                <div class="form-group">
                                    <label class="text-contrast text-center center-block">Afternoon</label>
                                    @if (ViewBag.noneditable)
                                    {
                                        @Html.DropDownListFor(x => x.BestTimeToCallNoon_Id, new SelectList(Model.BestTimeToCallNoon, "Value", "Text"), new { @id = "ddl_BestTimeToCallNoon", @class = "form-control", @onfocus = "RemoveValidation(this);", @disabled = "disabled" })
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(x => x.BestTimeToCallNoon_Id, new SelectList(Model.BestTimeToCallNoon, "Value", "Text"), new { @id = "ddl_BestTimeToCallNoon", @class = "form-control", @onfocus = "RemoveValidation(this);" })
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <h4 class="text-contrast form-label">Documents</h4>
                        <span class="accepted-file-block" style="color:red;">Max size  5mb(JPEG, JPG, PNG or PDF)</span>
                        <div class="col-md-12">
                            <div class="form-group file_upload_wrap">
                                <label class="text-contrast"><span class="required-fields"></span>Attach Goverment ID</label>
                                @if (ViewBag.noneditable)
                                {
                                    <input type="file" id="govidFile" name="GovIdFile" style="margin-top: 1%;" disabled="disabled" onchange="return ValidateFile(this);" />
                                }
                                else
                                {
                                    <input type="file" id="govidFile" name="GovIdFile" style="margin-top: 1%;" onchange="return ValidateFile(this);" />
                                }
                                @if (!String.IsNullOrWhiteSpace(Model.GovUrl))
                                {
                                    <a href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.GovUrl'>Download</a>
                                }
                            </div>
                            <div class="form-group file_upload_wrap">

                                <label class="text-contrast"><span class="required-fields"></span>Attach Company ID</label>
                                @if (ViewBag.noneditable)
                                {
                                    <input type="file" id="companyidFile" style="margin-top: 1%;" name="CompanyIdFile" disabled="disabled" onchange="return ValidateFile(this);" />
                                }
                                else
                                {
                                    <input type="file" id="companyidFile" style="margin-top: 1%;" name="CompanyIdFile" onchange="return ValidateFile(this);" />
                                }
                                @if (!String.IsNullOrWhiteSpace(Model.CompUrl))
                                {
                                    <a href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.CompUrl'>Download</a>
                                }
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group file_upload_wrap">
                                <label class="text-contrast"><span class="required-fields"></span>Attach Proof of Income</label>
                                @if (ViewBag.noneditable)
                                {
                                    <input type="file" id="incomeFile" name="IncomeIdFile" style="margin-top: 1%;" disabled="disabled" onchange="return ValidateFile(this);" />
                                }
                                else
                                {
                                    <input type="file" id="incomeFile" name="IncomeIdFile" style="margin-top: 1%;" onchange="return ValidateFile(this);" />
                                }
                                @if (!String.IsNullOrWhiteSpace(Model.IncomeUrl))
                                {
                                    <a href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.IncomeUrl'>Download</a>
                                }
                            </div>
                            <div class="form-group file_upload_wrap">
                                <label class="text-contrast"><span class="required-fields"></span>Attach Proof of Billing</label>
                                @if (ViewBag.noneditable)
                                {
                                    <input type="file" id="billingFile" style="margin-top: 1%;" name="BillingIdFile" disabled="disabled" onchange="return ValidateFile(this);" />
                                }
                                else
                                {
                                    <input type="file" id="billingFile" style="margin-top: 1%;" name="BillingIdFile" onchange="return ValidateFile(this);" />
                                }
                                @if (!String.IsNullOrWhiteSpace(Model.BillUrl))
                                {
                                    <a href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.BillUrl'>Download</a>
                                }
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group file_upload_wrap">
                                <label class="text-contrast">ATM Details Attachment</label>
                                @if (ViewBag.noneditable)
                                {
                                    <input type="file" id="ATMidFile" style="margin-top: 1%;" name="AtmIdFile" disabled="disabled" onchange="return ValidateFile(this);" />
                                }
                                else
                                {
                                    <input type="file" id="ATMidFile" style="margin-top: 1%;" name="AtmIdFile" onchange="return ValidateFile(this);" />
                                }
                                @if (!String.IsNullOrWhiteSpace(Model.AtmUrl))
                                {
                                    <a href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.AtmUrl'>Download</a>
                                }
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group file_upload_wrap">
                                <label class="text-contrast">Optional Attachment</label>
                                @if (ViewBag.noneditable)
                                {
                                    <input type="file" id="otherfile" style="margin-top: 1%;" name="OtherIdFile" disabled="disabled" onchange="return ValidateFile(this);" />
                                }
                                else
                                {
                                    <input type="file" id="otherfile" style="margin-top: 1%;" name="OtherIdFile" onchange="return ValidateFile(this);" />
                                }
                                @if (!String.IsNullOrWhiteSpace(Model.OthUrl))
                                {
                                    <a href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.OthUrl'>Download</a>
                                }

                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
