@using System.Configuration;
@using Loan_CRM.Models;
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/js")
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundle/datepicker")
    @Styles.Render("~/Content/Datepicker")
    @Scripts.Render("~/bundles/jqueryTimer")
</head>
<body>
    <div class="container body-content">
        @{
            if (Request.Cookies[CookiesKey.UserId] != null && Request.Cookies[CookiesKey.UserId].Value != null && Convert.ToInt32(Request.Cookies[CookiesKey.UserId].Value) > 0 && Request.Cookies[CookiesKey.RoleType] != null && Convert.ToString(Request.Cookies[CookiesKey.RoleType].Value).ToLower() == RoleType.Collector)
            {
                <div> @RenderBody()</div>
            }
            else if (Request.Cookies[CookiesKey.UserId] != null && Request.Cookies[CookiesKey.UserId].Value != null && Convert.ToInt32(Request.Cookies[CookiesKey.UserId].Value) > 0 && Request.Cookies[CookiesKey.RoleType] != null && Convert.ToString(Request.Cookies[CookiesKey.RoleType].Value).ToLower() == RoleType.Defaulter)
            {
                <div> @RenderBody()</div>
            }
            else if (Request.Cookies[CookiesKey.UserId] != null && Request.Cookies[CookiesKey.UserId].Value != null && Convert.ToInt32(Request.Cookies[CookiesKey.UserId].Value) > 0 && Request.Cookies[CookiesKey.RoleType] != null && Convert.ToString(Request.Cookies[CookiesKey.RoleType].Value).ToLower() == RoleType.TLDefaulter)
            {
                <div> @RenderBody()</div>
            }
            else if (Request.Cookies[CookiesKey.UserId] != null && Request.Cookies[CookiesKey.UserId].Value != null && Convert.ToInt32(Request.Cookies[CookiesKey.UserId].Value) > 0 && Request.Cookies[CookiesKey.RoleType] != null && Convert.ToString(Request.Cookies[CookiesKey.RoleType].Value).ToLower() == RoleType.TLSales)
            {
                <div> @RenderBody()</div>
            }
            else if (!String.IsNullOrEmpty(Convert.ToString(TempData["msg"])))
            {
                <h2>@Convert.ToString(TempData["msg"])</h2>
                <div style="display:none;"> @RenderBody()</div>
            }
            else
            {
                <h2>Multiple Users Logged-in on Single Browser</h2><h2>Please Use Single User at a time</h2>

                <div style="display:none;"> @RenderBody()</div>
            }
        }
        <div class="clearfix"></div>
        <hr />
        <footer class="main-footer">
            <div class="pull-left">
                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <td style="text-align:center">
                                <strong>Copyright &copy; @DateTime.Now.Year <a href="https://cashmart.ph/">Cashmart </a>.</strong> All rights
                                reserved.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="pull-right">
                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <td><a href="#"><strong>Version :-4.0.2.8 (10 Jun, 2024)</strong></a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </footer>
    </div>
    <script type="text/javascript">
        @RenderSection("scripts", required: false)
    </script>
</body>
</html>
