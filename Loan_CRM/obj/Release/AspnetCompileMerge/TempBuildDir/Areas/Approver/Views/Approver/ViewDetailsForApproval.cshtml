    <div class="col-md-6">
        <table id="tblCheckerHistory" border="1" class="table table-bordered dataTable no-footer table-striped">
            @{
                <tr>
                    <th>Verifier Name : </th>
                    <td colspan="3">@Model.username</td>
                </tr>
                <tr>
                    <th colspan="4" style="text-align:center">Remark History</th>
                </tr>
                <tr>
                    <th>Application No</th>
                    <th>Date</th>
                    <th>Remark</th>
                    <th>Remark By</th>
                </tr>
                if (Model.RemarkModelList != null && Model.RemarkModelList.Count > 0)
                {
                    foreach (var item in Model.RemarkModelList)
                    {
                        var remarkOn = item.createdon.ToString("dd-MM-yyyy hh:mm tt");
                        <tr>
                            <td>@item.application_id</td>
                            <td>@remarkOn</td>
                            <td>@item.remark</td>
                            <td>@item.createdbyname</td>
                        </tr>
                    }
                }
            }
        </table>
    </div>
    <div class="col-md-6">
        <table id="ApproverLoanDetails" class="table table-bordered table-responsive table-striped">
            <tr><th colspan="2">Approved Loan Details</th></tr>
            <tr>
                <td style="width:300px">Approved Loan Amount</td>
                <td style="width:400px"><label>@Model.ApprovedLoanAmount</label></td>

            </tr>
            <tr>
                <td style="width:300px">Term</td>
                <td style="width:400px"><label>@Model.AdditionalRequested_Term</label></td>
            </tr>
            <tr>
                <td style="width:300px">Interest Rate</td>
                <td style="width:400px"><label>@Model.ApprovedInterestRate</label></td>
            </tr>
            <tr>
                <td style="width:300px">Maturity Date</td>
                <td style="width:400px"><label>@Model.ApprovedMaturityDate</label></td>
            </tr>
            <tr>
                <td style="width:300px">Total Amount Due</td>
                <td style="width:400px"><label>@Model.ApprovedTotalDueAmount</label></td>
            </tr>

        </table>
        @{
            if (Model.BackActionName != "PreTermBucket" && Model.BackActionName != "ReLoanBucket" && Model.BackActionName != "PaymentHistory")
            {
                <div id="ControlButton">
                    <center>
                        <input type="button" id="Approve" class="btn btn-primary" onclick="Approve(@Model.ApplicationNo,@Model.userid)" value="Approve" />
                        <button type="button" class="btn btn-primary btn-flat" id="btn_notification">Manual Notify</button>
                        <input type="button" id="Decline" class="btn btn-danger " onclick="Decline(@Model.ApplicationNo)" value="Decline" />
                    </center>
                </div>
            }
        }

    </div>
}
else
{
    <div class="row">
        <center><h3>No Record Found</h3></center>
    </div>

}


<script type="text/javascript">
    $(window).scroll(function () {
        var height = $(window).scrollTop();
        if (height > 100) {
            $('#back2Top').fadeIn();
        } else {
            $('#back2Top').fadeOut();
        }
    });
    function Approve(id, user_id) {
        $.ajax({
            data: { id: id, user_id: user_id },
            url: '@Url.Action("ApproveLoanRequest","Approver")',
            success: function (data) {
                if (data) {
                    alert("Approved Successfully");
                    window.location.href = '@Url.Action("ApproverLoanRequestBucket", "Approver")';
                }
                else
                    alert("Error");
            },
            error: function (data) {
                window.location.reload(1);
            }
        });
    }
    function PaymentHistory(obj) {
        var url = '@Url.Action("PaymentHistory", "Loanoverdue", new { Area = "Collector" })?Id=' + obj +'&ActionName=LoanPaymentBucket';
        window.location.href = url;
    }
    function showremark() {
        $("#remarks").show();
    }
    $(document).ready(function () {
        $("#remarks").hide();
        $('select').attr('disabled', 'disabled');
        $('#ddlNotificationtemplate').removeAttr('disabled');
        $("#btn_notification").click(function () {
            NotifyModal();
        });
    });
    function Decline(id) {
        var remark = $("#txtRemarks").val();
        $.ajax({
            data: { remark: remark, id: id },
            url: '@Url.Action("DeclineLoanRequest","Approver")',
            success: function (data) {
                if (data) {
                    alert("Loan Request Declined");
                    window.location.href = '@Url.Action("ApproverLoanRequestBucket", "Approver")';
                }
                else
                    alert("Error");
            },
            error: function (data) {
                window.location.reload(1);
            }
        });
    }
    function CLicktocall(data) {
        $.ajax({
            async: false,
            type: 'GET',
            url: '@Url.Action("ClicktoCall", "Approver", new { area = "Approver" })',
            dataType: 'json',
            data: { ContactNumber: data },
            success: function (result) {
                if (result) {
                    availability = false;
                }
            }
        });
    }
    function ResetIsPickedApprover() {
        var appNo = @Request.QueryString["Id"];
        $.ajax({
            url: '@Url.Action("ResetIsPickedApprover", "Approver")',
            type: "POST",
            data: { appNo: appNo },
            success: function (result) {
                if (result == "True") {
                    window.location.href = '@Url.Action("ApproverLoanRequestBucket", "Approver")';
                }
                else
                    window.location.reload(1);
            }
        });
    }
    $(document).ready(function () {
        var action = "@Model.BackActionName"
        if (action != "ApproverLoanBucket") {
            $('#Approve').hide();
            $('#Decline').hide();
        }
    });
     function NotifyModal() {
        var modalNotify = document.getElementById('modalNotify');
        modalNotify.style.display = "block";
    }
    function SendNotify() {
        debugger;
        $.ajax({
            type: 'POST',
            dataType: 'json',
            data: { notificationtoken: '@Model.notificationtoken', message: $("#txtnotifydefinition").val(), UserName: '@Convert.ToString(Request.Cookies["AgentName"].Value)', PanelName: '@Convert.ToString(Request.Cookies["RoleType"].Value)', MobileNo: '@Model.PersonalContactNo', ApplicationNo: '@Model.ApplicationNo' },
            url: '@Url.Action("SendManulNotification", "Home", new { Area = "" })',
            success: function (data)
            {
                if (data) {
                    alert("Notification Send Succussfully..");
                    $('#modalNotify').toggle();
                }
            }
        });
    };
    function GetNotificationValue() {
        var Id = $('#ddlNotificationtemplate').val();
        $.ajax({
            async: false,
            type: 'GET',
            url: '@Url.Action("GetNotificationValues", "LoanRequestBucket", new { area = "Checker" })',
            dataType: 'json',
            data: { Id: Id },
            success: function (sms) {
                if (sms != null) {
                    $("#txtnotifydefinition").val(sms.NotificationTemplateDefinition);
                    $("#txtnotifydescription").val(sms.NotificationTemplateDesc);
                }
            },
            error: function (data) {
                window.location.reload(1);

            }
            });
    };
    function RefreshNotifyModel() {
        $('#modalNotify').toggle();
        $("#ddlNotificationtemplate").val('');
        $("#txtnotifydefinition").val('');
        $("#txtnotifydescription").val('');
    }
</script>
<style>
    .ClsCheckBox {
        width: 50px;
        padding-left: 3%;
    }
</style>
