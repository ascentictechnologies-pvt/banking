@model Loan_CRM.Models.NonPaymentReasonModelVM

    @{
        ViewBag.Title = "Non Payment Reason";
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        @Styles.Render("~/Content/DataTable");
        @Scripts.Render("~/Script/DataTable");
    }
    <style>
        .has-error {
            color: red !important;
        }
    </style>
    <h2></h2>
    <div id="MsgDiv">
        @if (TempData["msg"] != null)
        {
            if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") ||  Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
            else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
        }
    </div>
    <div class="col-md-12">
        @using (Html.BeginForm())
        {
            <div class="col-md-4">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <span>Add Reason of Non-Payment Details</span>
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                            <input type="hidden" id="reason_id" name="reason_id" value="@Model.reason_id" />
                            <label>Reason Name</label>
                            @Html.TextBoxFor(x => x.reason_text, new { @class = "form-control CharcaterTextBox", @placeholder = "Reason Name", @maxlength = "1000", @onfocus = "RemoveValidation(this);" })
                            @Html.ValidationMessageFor(x => x.reason_text, null, new { @class = "has-error" })
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div>
                            <input type="submit" id="btnSave" value="Save" class="btn btn-success" />
                            <input type="button" value="Reset" id="btnReset" class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <span>Reason of Non-Payment Details</span>
                    </div>
                    <div class="panel-body">
                        <table id="tblReasonOfNonPayment" class="table table-striped table-responsive">
                            <thead>
                                <tr>
                                    <th>SNO</th>
                                    <th>Reason Name</th>
                                    <th>Created On</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.NonPaymentReasonModelList != null && Model.NonPaymentReasonModelList.Count > 0)
                                    {
                                        int i = 1;
                                        foreach (var item in Model.NonPaymentReasonModelList)
                                        {
                                            <tr>
                                                <td>@i</td>
                                                <td>@item.reason_text</td>
                                                <td>@item.created_on</td>
                                                <td>
                                                    <a style="cursor:pointer;" onclick="EditData('@item.reason_id')">Edit</a> | @{
                                                        if (item.isactive.HasValue == true && item.isactive.Value == true)
                                                        {
                                                            <a class="anchor" onclick="DisableData(@item.reason_id)" title="Click to Disable"><img src="~/Content/img/Circle_Green.png" alt="Enable" height="18" width="18" /></a>
                                                        }
                                                        else
                                                        {
                                                            <a class="anchor" onclick="EnableData(@item.reason_id)" title="Click to Enable"><img src="~/Content/img/Circle_Red.png" alt="Disable" height="18" width="18" /></a>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                            i = i + 1;
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#MsgDiv").show(500);
        $("#tblReasonOfNonPayment").DataTable();
        $("#btnReset").click(function () {
            $("#reason_id").val("0");
            $("#reason_text").val("");
            $("#btnSave").val("Save");
        });
        });
        $("#btnReset").click(function () {
            window.location.reload();
        });
    //Remove Validation
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
    function EditData(Id) {
        
        $.ajax({
            url: '@Url.Action("EditReasonOfNonPayment", "Admin",new { Area="Admin"})',
            type: "POST",
            data: { Id: Id },
            success: function (result) {
                
                if (result != null) {
                    $("#reason_id").val(result[0].reason_id);
                    $("#reason_text").val(result[0].reason_text);
                    $("#btnSave").val("Update");
                }
                else {
                    window.location.reload(1);
                }
            },
            error: function (result) {
                window.location.reload(1);
            }
        });
    }
    function DisableData(id) {
            var r = confirm("Are you sure to Disable this Reason?");
            if (r == true) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DisableReasonOfNonPayment", "Admin",new { Area="Admin"})',
                        data: { id: id },
                        success: function (data) {
                            console.log(data);

                           
                                window.location.href = '@Url.Action("NonPaymentReason", "Admin",new {Area="Admin"})';
                            
                        }
                    });
            }
        }
        function EnableData(id) {
            var r = confirm("Are you sure to Enable this Reason?");
            if (r == true) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("EnableReasonOfNonPayment", "Admin",new { Area="Admin"})',
                    data: { id: id },
                    success: function (data) {
                        console.log(data);
                      
                            window.location.href = '@Url.Action("NonPaymentReason", "Admin",new {Area="Admin"})';
                        
                    }
                });
            }
    }
    </script>
