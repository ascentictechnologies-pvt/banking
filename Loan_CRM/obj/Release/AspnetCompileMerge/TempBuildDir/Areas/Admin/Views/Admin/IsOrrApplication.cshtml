@model Loan_CRM.Models.ApplicationRecordVM
@using System.Configuration;
@{
    ViewBag.Title = "Is ORR Application List";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}

@using (Html.BeginForm("IsOrrApplication", "Admin", FormMethod.Post))
{
    <div id="MsgDiv">
        @if (TempData["msg"] != null)
        {
            if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
            else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
        }
    </div>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <div class="row">
                <div class="col-md-3">
                    <h4>Is ORR True Application</h4>
                </div>
                <div class="col-md-3">
                    @Html.HiddenFor(x => x.DateRange, new { @id = "date_range" })
                    <div id="reportrange" name="DateRange" style="background: #808080ff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc;">
                        <i class="fa fa-calendar"></i>&nbsp;
                        <span></span><i class="fa fa-caret-down"></i>
                    </div>
                </div>
                <div class="col-md-2">
                    <input type="button" style="float:right" class="btn btn-success btn-flat" value="Get Data" onclick="GetValue();" />
                </div>
               
                <div id="buttons" class="col-md-2">

                </div>
            </div>
        </div>
        <div class="panel-body">
            <table id="tblRecord" class="table table-bordered table-responsive table-striped">
                <thead>
                    <tr>
                        <th>Application No</th>
                        <th>Date Applied</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Contact Number</th>
                        <th>Remarks</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                @*@foreach (var item in Model.ApplicationRecordList)
                {
                    <tr>
                        <td>@item.ApplicationNo</td>
                        <td>@item.DateApplied</td>
                        <td>@item.First_Name @item.Middle_Name @item.Last_Name</td>
                        <td>@item.PersonalEmail</td>
                        <td>@item.PersonalContactNo</td>
                        <td>@item.checker_remark</td>
                        <td><img src='../../../Content/images/Delete.png' style='width: 18%;cursor: pointer;' onclick='DelecteDeclinedApplication(@item.ApplicationNo)' /></td>
                    </tr>
                }*@
            </table>
        </div>
    </div>




    <div id="tableDiv">
        <h3></h3>
        <div>

            <div class="col-md-2">

            </div>
            <div class="col-md-2">

            </div>

        </div>

        <div class="col-md-12">

        </div>
    </div>
}

<script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<script src="https://cdn.datatables.net/buttons/1.5.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.5.1/js/buttons.html5.min.js"></script>
<script type="text/javascript">
    var table = $("#tblRecord").DataTable();
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass('has-error');
    }
    $(document).ready(function () {
        var start = moment().subtract(29, 'days');
        var end = moment();

        function cb(start, end) {
            $('#reportrange span').html(start.format('MMMM D, YYYY') + ' - ' + end.format('MMMM D, YYYY'));
        }

        $('#reportrange').daterangepicker({
            startDate: start,
            endDate: end,
            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
        }, cb);

        cb(start, end);
        GetValue();
        
    });

    function GetValue() {
        var filter_date = $('#reportrange span').text();
        $('#date_range').val(filter_date);
     table.destroy();
         table = $("#tblRecord").DataTable({
     "processing": true, // for show progress bar
     "serverSide": true,
         "filter": false,
         "dom": 'Blfrtip',
         "buttons": [
             'excel'
         ],
     "orderMulti": false, // for disabkle multiple column at once
     "pageLength": 10,
     "lengthChange": true,
     "bInfo": false,
         "ajax": {
             "url": '@Url.Action("GetOrrData", "Admin", new { Area = "Admin" })',
             "type": "POST",
             "data": { "DateRange": filter_date },
             "datatype": "json",
             error: function (data) {
                 console.log(data);
             }
         },
         "columns": [

             { "data": "ApplicationNo", "name": "ApplicationNo" },
             { "data": "DateApplied", "name": "DateApplied" },
             { "data": "ApplicantFullName", "name": "ApplicantFullName" },
             { "data": "PersonalEmail", "name": "PersonalEmail" },
             { "data": "PersonalContactNo", "name": "PersonalContactNo" },
             { "data": "checker_remark", "name": "checker_remark" },
             {
                 "render": function (data, type, full, meta) {
                    return '<img src="../../Content/Images/Delete.png" style="width: 50%; cursor: pointer;" onclick="DelecteDeclinedApplication('+full.ApplicationNo+')"/>';
                 }
             }]
     });
        //var buttons = new $.fn.dataTable.Buttons(table, {
        //    buttons: [
        //        {
        //            extend: 'excelHtml5',
        //            text: 'EXCEL EXPORT',
        //            className: 'btn btn-info pull-right'
        //        }
        //    ]
        //}).container().appendTo($('#buttons'));
     setInterval(function () {
         table.ajax.reload();
     }, @Convert.ToInt32(ConfigurationManager.AppSettings["GridRefreshTime"]));
 }
    function RemoveFilter() {
        var url = '@Url.Action("IsOrrApplication", "Admin")';
        window.location.href = url;
    }
    function DelecteDeclinedApplication(AppId)
    {
        $.ajax({
            data: { AppId: AppId },
            url: '@Url.Action("DeleteDuplicateRecord", "Admin")',
            success: function (data)
            {
                if (data) {
                    alert("Deleted Successfully");
                }
                window.location.href = '@Url.Action("IsOrrApplication", "Admin", new { area = "Admin" })';
            }
        });
    }
</script>

<style>
    .has-error {
        border-color: red;
    }
</style>