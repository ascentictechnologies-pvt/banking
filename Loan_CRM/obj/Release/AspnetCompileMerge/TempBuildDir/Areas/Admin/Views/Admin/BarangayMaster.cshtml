@model Loan_CRM.Models.BarangayModelVM

@{
    ViewBag.Title = "BarangayMaster";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<style>
    .has-error {
        color: red !important;
    }
</style>
<h2></h2>
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="col-md-12">
    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Add Barangay Details</span>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <input type="hidden" id="id" name="id" value="@Model.Id" />
                        <label>Barangay Name</label>
                        @Html.TextBoxFor(x => x.Barangay_Name, new { @class = "form-control CharcaterTextBox", @placeholder = "Barangay Name", @id = "barangay_name", @maxlength = "50", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.Barangay_Name, null, new { @class = "has-error" })
                    </div>
                    <div class="form-group">
                        <label>City</label>
                        @Html.DropDownListFor(x => x.cityId, new SelectList(Model.CityList, "cityid", "cityname"), new { @class = "form-control", @id = "ddlCity" })
                    </div>
                </div>
                <div class="panel-footer">
                    <div>
                        <input type="submit" id="btnSave" value="Save" class="btn btn-success" />
                        <input type="button" value="Reset" id="btnReset" class="btn btn-danger" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Barangay Details</span>
                </div>
                <div class="panel-body">
                    <table id="tblBarangay" class="table table-striped table-responsive">
                        <thead>
                            <tr>
                                <th>Barangay Name</th>
                                <th>City Name</th>
                                <th>Is ORR</th>
                                <th>Created On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
<script src="//ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>

<link href="https://cdn.datatables.net/1.10.15/css/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/responsive/2.1.1/css/responsive.bootstrap.min.css" rel="stylesheet" />

<script src="https://cdn.datatables.net/1.10.15/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.15/js/dataTables.bootstrap4.min.js "></script>
<script type="text/javascript">
    $(document).ready(function () {
        //-----------Server Side Datatable Start-----------
        $("#tblBarangay").DataTable({
           "processing": true, // for show progress bar
           "serverSide": true, // for process server side
           "filter": true, // this is for disable filter (search box)
           "orderMulti": false, // for disable multiple column at once
           "pageLength": 10,

           "ajax": {
               "url": '@Url.Action("GetBarangayData", "Admin", new { Area = "Admin" })',
               "type": "POST",
               "datatype": "json",
               error: function (data) {
                   console.log(`Error :` + data);
               }
           },

          
           "columns": [
               { "data": "Barangay_Name", "name": "Barangay Name" },
               { "data": "cityname", "name": "City Name" },
               {
                   "render": function (data, type, full, meta) {
                       if (full.Is_ORR == true) {
                           return '<a class="anchor" onclick="DisableORR('+full.Id+')" title="Click to Disable"><img src="/Content/img/Circle_Green.png" alt="Enable" height="18" width="18" /></a>';
                       }
                       else {
                           return '<a class="anchor" onclick="EnableORR('+full.Id+')" title="Click to Enable"><img src="/Content/img/Circle_Red.png" alt="Enable" height="18" width="18" /></a>';
                       }
                   }
               },
               { "data": "created_on",  "name": "Created On"},
               {
                   "render": function (data, type, full, meta) {
                        if (full.is_active == true) {
                            return '<a style="cursor:pointer;" onclick="EditData(' + full.Id + ')">Edit</a> | <a class="anchor" onclick="DisableData(' + full.Id+')" title="Click to Disable"><img src="/Content/img/Circle_Green.png" alt="Enable" height="18" width="18" /></a>';
                       }
                       else {
                           return '<a style="cursor:pointer;" onclick="EditData(' + full.Id + ')">Edit</a> | <a class="anchor" onclick="EnableData('+full.Id+')" title="Click to Enable"><img src="/Content/img/Circle_Red.png" alt="Disable" height="18" width="18" /></a>';
                       }
                   }
               }
           ]
           
        })
        //---------- Server Side Datatable End-------------
        $("#btnReset").click(function () {
            $("#id").val("0");
            $("#barangay_name").val("");
            $("#btnSave").val("Save");
        });
    });
    //Remove Validation
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
    $("#btnReset").click(function () {
        window.location.reload();
    });
    function EditData(Id) {
        
        $.ajax({
            url: '@Url.Action("EditBarangayData", "Admin",new { Area="Admin"})',
            type: "POST",
            data: { Id: Id },
            success: function (result) {
                
                if (result != null) {
                    $("#id").val(result[0].Id);
                    $("#barangay_name").val(result[0].Barangay_Name);
                    $('#ddlCity option[value="' + result[0].cityId + '"]').attr("selected", "selected");
                    $("#btnSave").val("Update");
                }
                else {
                    window.location.reload(1);
                }
            },
            error: function (data) {
                console.log(`Error :` + data);
            }
        });
    }
    function DisableData(id) {
        var r = confirm("Are you sure to Disable this Barangay?");
            if (r == true) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DisableBarangay", "Admin",new { Area="Admin"})',
                        data: { id: id },
                        success: function (data) {
                            console.log(data);

                            if (data) {
                                window.location.href = '@Url.Action("BarangayMaster", "Admin",new {Area="Admin"})';
                            }
                        }
                    });
            }
        }
        function EnableData(id) {
            var r = confirm("Are you sure to Enable this Barangay?");
            if (r == true) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("EnableBarangay", "Admin",new { Area="Admin"})',
                    data: { id: id },
                    success: function (data) {
                        console.log(data);
                        if (data) {
                            window.location.href = '@Url.Action("BarangayMaster", "Admin",new {Area="Admin"})';
                        }
                    }
                });
            }
    }

        function DisableORR(id) {
            var r = confirm("Are you sure to Disable ORR?");
            if (r == true) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DisableIsOrrBarangay", "Admin",new { Area="Admin"})',
                        data: { id: id },
                        success: function (data) {
                            console.log(data);

                            if (data) {
                                window.location.href = '@Url.Action("BarangayMaster", "Admin",new {Area="Admin"})';
                            }
                        }
                    });
            }
        }
        function EnableORR(id) {
            var r = confirm("Are you sure to Enable ORR?");
            if (r == true) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("EnableIsOrrBarangay", "Admin",new { Area="Admin"})',
                    data: { id: id },
                    success: function (data) {
                        console.log(data);
                        if (data) {
                            window.location.href = '@Url.Action("BarangayMaster", "Admin",new {Area="Admin"})';
                        }
                    }
                });
            }
        }
</script>
