    function GetCalculatedAmountPay() {

        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetCalcPenalityAmount", "Loanoverdue")',
            data: { id: _ApplicationNo, Date: $('#txtPayDate').val() },
            success: function (data) {
                console.log(data);
                if (data) {
                    $("#txtPayAmortization").val(parseFloat(data._DueAmount).toFixed(2));
                    $("#txtPayLatepenalties").val(parseFloat(parseFloat(data._Penality) + parseFloat(data.LateFee)).toFixed(2));
                    var Total = parseFloat($("#txtPayAmortization").val()) + parseFloat(data._Penality) + parseFloat(data.LateFee);
                    $("#txtPayTotal").val(parseFloat(Math.round(Total * 100) / 100).toFixed(2));
                }
                else {
                    alert("Application Number does not exists");
                }
            }
        });
    };

