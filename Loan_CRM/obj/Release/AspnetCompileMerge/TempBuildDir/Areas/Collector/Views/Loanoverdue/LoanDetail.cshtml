@using System.Configuration;
@model Loan_CRM.Areas.Collector.Models.PaymentInformation
@{
    ViewBag.Title = "Loan Detail";
    Layout = "~/Views/Shared/_LayoutCollector.cshtml";
}

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
<link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<script src="~/Content/js/ValidateNumericText.js"></script>
<script src="~/Content/js/ValidateCharcterText.js"></script>
<script src="~/Content/js/emailvalidation.js"></script>
<script src="~/Content/js/jquery.js"></script>
<script src="~/Content/js/jquery-ui.js"></script>
<link href="~/Content/jquery-ui.css" rel="stylesheet">
<style>
    .mydiv {
        position: absolute;
        top: 50%;
        left: 50%;
        /*width: 30em;
        height: 18em;*/
        margin-top: -9em; /*set to a negative number 1/2 of your height*/
        margin-left: -15em; /*set to a negative number 1/2 of your width*/
        /*border: 1px solid #ccc;
        background-color: #f3f3f3;*/
    }
</style>

@using (Html.BeginForm("LoanDetail", "Loanoverdue", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div id="MsgDiv">
        @if (TempData["msg"] != null)
        {
            if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
            else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                    <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
                </div>
            }
        }
    </div>
    <div id="loadingDiv">
        <img src="../../../Content/images/Loader.gif" class="mydiv" loop=infinite />
    </div>
    <div id="modalNotify" class="modal" style="width:70%; padding-left:30%; padding-top:5%">
        <div class="modal-content">
            <div class="modal-header">
                <span class="close" onclick="RefreshNotifyModel()">&times;</span>
                <h3>Notification Template</h3>
            </div>
            <div class="modal-body">
                <div class="row form-group spc">
                    <div class="col-md-6">
                        <label>Notification Template Name</label>
                    </div>
                    <div class="col-md-6">
                        @{
                            if (ViewBag.NotificationTemplateList != null)
                            {
                                @Html.DropDownListFor(Model => Model.templatename, new SelectList(ViewBag.NotificationTemplateList, "id", "NotificationTemplateName"), new { @class = "form-control", @id = "ddlNotificationtemplate", @onchange = "GetNotificationValue();" })
                            }
                        }
                    </div>
                </div>
                <div class="row form-group spc">
                    <div class="col-md-6">
                        <label>Notification Template Description</label>
                    </div>
                    <div class="col-md-6">
                        <textarea class="form-control" id="txtnotifydescription" readonly></textarea>
                    </div>
                </div>
                <div class="row form-group spc">
                    <div class="col-md-6">
                        <label>Notification Template Definition</label>
                    </div>
                    <div class="col-md-6">
                        <textarea class="form-control" id="txtnotifydefinition" readonly></textarea>
                    </div>
                </div>

                <div class="clearfix"></div>
            </div>
            <div class="modal-footer">
                <input type="button" class="btn btn-primary btn-flat" id="btnPaySubmit" value="Send" onclick="SendNotify()" />
                <input type="button" class="btn btn-danger btn-flat" id="btnPayCancel" value="Cancel" onclick="RefreshNotifyModel()" />
            </div>
        </div>
    </div>
    <div class="content-wrapper">
        <div class="container" id="mainContainer">

            <section class="content">
                <div class="col-md-7">
                    <div class="box box-default">
                        <div class="col-md-12">
                            <table class="table table-bordered table-striped">
                                <tr>
                                    <th colspan="2" style="text-align:center;">Customer Details</th>
                                </tr>
                                <tr>
                                    <td style="width:263px">Name</td>
                                    <td style="width:263px"><input type="text" class="form-control" id="txtname" placeholder="Name" readonly="readonly" value="@Model.Name" /></td>

                                </tr>
                                <tr>
                                    <td style="width:263px">Reloan Count</td>
                                    <td style="width:263px"><input type="text" class="form-control" id="reloancount" placeholder="Reloan Count" readonly="readonly" value="@Model.ReloanCount" /></td>

                                </tr>
                                <tr>
                                    <td>Application No</td>

                                    <td> <input type="text" class="form-control" readonly="readonly" placeholder="Application No" value="@Model.applicationno" /></td>
                                </tr>
                                <tr>
                                    <td>Contract No</td>
                                    <td><input type="text" class="form-control" placeholder="Contract No" readonly="readonly" value="@Model.Contractno" /></td>

                                </tr>
                                <tr>
                                    <td>Reference No</td>
                                    <td><input type="text" class="form-control" placeholder="Reference No" readonly="readonly" value="@Model.Referenceno" /></td>

                                </tr>

                                <tr>
                                    <td>Date of Disbursemant</td>
                                    <td><input type="text" class="form-control" placeholder="Date of Disbursemant" readonly="readonly" value="@Model.disbursemant" /></td>
                                </tr>
                                <tr>
                                    <td>Due Date</td>
                                    <td><input type="text" class="form-control" id="currentdate" placeholder="Due Date" readonly="readonly" value="@Model.Dueedate" /></td>

                                </tr>
                                <tr>
                                    <td>Term</td>
                                    <td><input type="text" class="form-control" placeholder="Term" readonly="readonly" value="@Model.Term" /></td>
                                </tr>
                                <tr>
                                    <td>Principal</td>
                                    <td><input type="text" class="form-control" placeholder="Principal" readonly="readonly" value="@Model.principal" /></td>
                                </tr>

                                <tr>
                                    <td>Amortization</td>
                                    <td><input type="text" class="form-control" placeholder="Amortization" readonly="readonly" value="@Model.amortization" /></td>
                                </tr>
                                <tr>
                                    <td>Outstanding</td>
                                    <td><input type="text" class="form-control" readonly="readonly" placeholder="Outstanding" value="@Model.PayableAmount " /></td>
                                </tr>
                                <tr>
                                    <td>Outstanding Late Penalties</td>
                                    <td><input type="text" class="form-control" readonly="readonly" placeholder="Outstanding Late Penalties" value="@(Convert.ToDecimal(Model.LateFee)+Convert.ToDecimal(Model._Penality))" /></td>
                                </tr>
                                <tr>
