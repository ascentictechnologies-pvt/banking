                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-5" style="margin-top: -5px;">
                    <div style="margin-top: 6px;">
                        <table class="table table-bordered table-striped">
                            <tr>
                                <th colspan="3" style="text-align:center;">References</th>
                                <th colspan="2" style="text-align:center;">Action</th>
                            </tr>
                            <tr>
                                <td>@Model.familyname1</td>
                                <td>@Model.familyrelation1</td>
                                <td>
                                    @{
                                        if (Model.familycontact1 != "" && Model.familycontact1 != null)
                                        {
                                            <input type='button' value='Call' class='btn btn-danger' id='btnCall' onclick='ClickCall("@Model.familycontact1")' />

                                        }
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>@Model.familyname2</td>
                                <td>@Model.familyrelation2</td>
                                <td>
                                    @{
                                        if (Model.familycontact2 != "" && Model.familycontact2 != null)
                                        {
                                            <input type='button' value='Call' class='btn btn-danger' id='btnCall' onclick='ClickCall("@Model.familycontact2")' />
                                        }
                                    }
                                </td>
                            </tr>
                            <tr>
