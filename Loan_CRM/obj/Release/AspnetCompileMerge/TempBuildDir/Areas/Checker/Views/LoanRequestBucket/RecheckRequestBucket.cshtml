@using System.Configuration;

@{
    ViewBag.Title = "Rechecker Request Bucket";
    Layout = "~/Views/Shared/_LayoutChecker.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="pull-left">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <td style="text-align:center">
                    <b style="font-size:20px;">Re-Checker Loan Request Bucket</b>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="pull-right">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <td style="text-align:center">
                    <input type="button" class="btn btn-primary btn-flat" value="Back" onclick="location.href='@Url.Action("LoanRequest", "LoanRequestBucket")'" />
                </td>
            </tr>
        </tbody>
    </table>
</div>

@{
    Loan_CRM.Areas.Checker.Models.Checkerdetail product = new Loan_CRM.Areas.Checker.Models.Checkerdetail();
}
<div id="loadingDiv">
    <img src="../../../Content/images/Loader.gif" class="classname" loop=infinite />
</div>
<table id="tblVerify" class="table table-bordered dataTable no-footer">
</table>
<script type="text/javascript">
    function GetData()
    {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetRechekUsersData", "LoanRequestBucket")',
            datatype: 'json',
            beforeSend: function () {
                $("#loadingDiv").show();
            },
            success: function (usersdetail) {
                if (usersdetail) {
                    var _data = '';
                    var ApplicationValidation = '';
                    var All_Attechment = '';
                    var InProcess = '';
                    console.log(usersdetail);
                    _data += "<thead><tr><th>Sr No.</th><th> Applicant No</th><th>Applicant Name</th><th>Request Date</th><th>Best Call Morning</th><th>Best Call Noon</th><th>Action</th><th></th><th></th></tr></thead><tbody>";
                    $.each(usersdetail, function (i, data) {
                        ApplicationValidation = "<img src='../../Content/img/Circle_Yellow.png' style='margin-left: 8%;'/>";
                        All_Attechment = "<img src='../../Content/img/Circle_Yellow.png' style='margin-left: 8%;'/>";
                        InProcess = '';
                        if (data.term != 0) {
                            ApplicationValidation = "<img src='../../Content/img/Circle_Green.png' style='margin-left: 8%;'/>";
                        }
                        if (data.companyid_url != '' && data.gov_id_url != '' && data.billing_url != '' && data.income_url != '' && data.other_url != '') {
                            All_Attechment = "<img src='../../Content/img/Circle_Green.png' style='margin-left: 8%;'/>";
                        }
                        if (data.ispickedrechecker == true) {
                            InProcess = "<span style='color:red;'>In Process...</span>";
                        }
                        _data += "<tr><td>" + data.Id + "</td><td>" + data.applicationno + "</td><td>" + data.applicationname + "</td><td>" + data.RequestDate + "</td><td>" + data.MorningTime + "</td><td>" + data.NoonTime + "</td>";
                        if (data.ispickedrechecker == true) {
                            _data += "<td> " + InProcess + "</td><td>" + ApplicationValidation + "</td><td>" + All_Attechment + "</td></tr>";
                        }
                        else {
                            _data += "<td><input type='button' value='Detail' class='btn btn-primary' id='btnDetail' onclick='Requestdetail(" + data.applicationno + " ," + data.personalcontactno + ")'/></td><td>" + ApplicationValidation + "</td><td>" + All_Attechment + "</td></tr>";
                        }


                    });
                    _data += "</tbody>";
                    $("#tblVerify").html(_data);
                    $("#tblVerify").DataTable().destroy();
                    $("#loadingDiv").hide();
                    setTimeout(GetData, @Convert.ToInt32(ConfigurationManager.AppSettings["GridRefreshTime"]));
                }
                else {
                    window.location.reload(1);
                }
            },
            error: function (usersdetail) {
                window.location.reload(1);
            }

        });
    }
    $(document).ready(function () {
        GetData();
    });
    function Requestdetail(obj, obj1) {
        var url = '@Url.Action("RequestDetail", "LoanRequestBucket")?Id=' + obj + '&phoneNumber=' + obj1 + '&Actionname=RecheckRequestBucket';
        window.location.href = url;
    }
</script>
<style>
    .classname {
        position: absolute;
        z-index: 10;
        top: 300px;
        left: 600px;
    }
</style>