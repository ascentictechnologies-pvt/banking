@using System.Configuration;
@{
    ViewBag.Title = "Account Summery";
    Layout = "~/Views/Shared/_LayoutAccount.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<style>
    .has-error {
        border-color: red;
    }
</style>
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="pull-left">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <td style="text-align:center">
                    <b style="font-size:20px;">Accounts Portfolio Summary</b>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="pull-right">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <td>
                    <label><span style="color: #ff0000;">*</span>From Date</label>
                    <input type="text" name="fromdate" id="txtFromDate" class="form-control" readonly placeholder="Enter Start Date" onclick="RemoveValidation(this);" />
                </td>
                <td>
                    <label><span style="color: #ff0000;">*</span>To Date</label>
                    <input type="text" name="todate" id="txtEndDate" class="form-control" readonly placeholder="Enter End Date" onclick="RemoveValidation(this);" />
                </td>
                <td style="text-align:center">
                    <input type="button" style="margin-top: 15px;" class="btn btn-primary btn-flat" value="Get Record" onclick="GetData();" />
                </td>
                <td style="text-align:center">
                    <input type="button" style="margin-top: 15px;" id="btnExcel" class="btn btn-primary btn-flat" value="Export to Excel" />
                </td>
                <td style="text-align:center">
                    <input type="button" style="margin-top: 15px;" class="btn btn-primary btn-flat" value="Back" onclick="location.href='@Url.Action("GetAccountApproverData", "AccountApprover")'" />
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="clearfix"></div>
<div id="loadingDiv">
    <img src="../../../Content/images/Loader.gif" class="classname" loop=infinite />
</div>
<div class="row table-responsive">
    <table id="tblVerify" class="data-verification table table-bordered dataTable no-footer table-striped"></table>
</div>
<script type="text/javascript">

    $(document).ready(function () {
        $("#loadingDiv").hide();
        $("#txtFromDate").datepicker({
            dateFormat: 'dd-mm-yy',
            changeMonth: true,
            changeYear: true,
            yearRange: "-100:+0",
            maxDate: new Date()
        });
        $('#txtFromDate').change(function () {
            var from = $('#txtFromDate').datepicker('getDate');
            var date_diff = Math.ceil((from.getTime() - Date.parse(new Date())) / 86400000);
            var maxDate_d = date_diff + 5000 + 'd';
            date_diff = date_diff + 'd';
            $('#txtEndDate').val('').removeAttr('disabled').removeClass('hasDatepicker').datepicker({
                dateFormat: 'dd-mm-yy',
                minDate: date_diff,
                maxDate: maxDate_d
            });
        });
        $("#txtEndDate").datepicker({
            dateFormat: "dd-mm-yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "-100:+0"
        });
        $("#btnExcel").click(function (e) {
              var dt = new Date();
                            var day = dt.getDate();
                            var month = dt.getMonth() + 1;
                            var year = dt.getFullYear();
                            var hour = dt.getHours();
                            var mins = dt.getMinutes();
    var table_div = document.getElementById('tblVerify');
                            var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
                            //creating a temporary HTML link element (they support setting file names)
                            var a = document.createElement('a');
                            //getting data from our div that contains the HTML table
                            var data_type = 'data:application/vnd.ms-excel';

                            var table_html = table_div.outerHTML.replace(/ /g, '%20');
                            a.href = data_type + ', ' + table_html;
                            //setting the file name
                            a.download = 'Disbursment' + postfix + '.xls';
                            //triggering the function
                            a.click();
                            //just in case, prevent default behaviour
                            e.preventDefault();

        });
    });

    function RemoveValidation(obj) {

        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
    function GetData() {

        var flag = 0;
        var StartDate = $("#txtFromDate").val();
        var EndDate = $("#txtEndDate").val();

        //var appNo = $("#txtAppNo").val();
        //var contractNo = $("#txtContractNo").val();
        //var clientName = $("#txtClientName").val();
        var status;
        if (StartDate == "") {
            $("#txtFromDate").addClass('has-error');
            flag++;
        }
        if (EndDate == "") {
            $("#txtEndDate").addClass('has-error');
            flag++;
        }
        if (flag > 0) {
            return false;
        }
        else {

            $.ajax({

            type: 'GET',
            url: '@Url.Action("GetUsersData", "SummeryDetail")',
            datatype: 'json',
            data: {Fromdate:StartDate,ToDate:EndDate},
            beforeSend: function () {
                $("#loadingDiv").show();
            },
                success: function (users) {
                    if (users != null) {
                        $("#tblVerify").empty();
                        $(".data-verification").append("<thead><tr><th>Applicant No</th><th>Contract no</th><th>Client Name</th><th>Date of Export</th><th>Maturity Date</th><th>Principal Loan</th><th>Term</th><th>Interest Rate</th><th>Outstanding Balance</th><th>Installment Payment</th>" +
                            "<th>EMI Status</th>" +
                            "<th> Other Info</th > </tr ></thead ><tbody>");
                        $.each(users, function (i, data) {
                            var inProcess = '';
                            var EmiStat = "";
                            status = "<img src='../../Content/img/Circle_Green.png' title='Unprocessed Payment' />";
                            if (data.IsApproved == true) {
                                status = "<img src='../../Content/img/Circle_Green.png' title='Unprocessed Payment' />";
                            }
                            else {
                                status = "<img src='../../Content/img/Circle_Yellow.png' title='Processed Payment' />";
                            }
                            if (data.EmiStatus == 0) {
                                EmiStat = "Pending"
                            }
                            if (data.EmiStatus == 1) {
                                EmiStat = "Created"
                            }
                            $(".data-verification").append(
                                "<tr><td>" + data.applicationno + "</td>" +
                                "<td>" + data.Contactno + "</td>" +
                                "<td>" + data.ClientName + "</td>" +
                                "<td>" + data.Dateofreleased + "</td>" +
                                "<td>" + data.MaturityDate + "</td>" +
                                "<td>" + data.Principleloan + "</td>" +
                                "<td>" + data.term + "</td>" +
                                "<td>" + data.interestrate + "</td>" +
                                "<td>" + data.Osbalance + "</td>" +
                                "<td>" + data.Installmentpayment + "</td>" +
                                "<td>" + EmiStat + "</td>" +
                                "<td><input type='button' value='Detail' class='btn btn-primary' id='btnDetail' onclick='Requestdetail(" + data.applicationno + ")'/></td>"
                            );
                        });
                        $(".data-verification").append("</tbody> ");
                        $("#tblVerify").DataTable().destroy();
                        $("#loadingDiv").hide();
                        }
                    else {
                        window.location.reload(1);
                    }
                },
                error: function (data) {
                    console.log(`Error :` + data);
                //    window.location.reload(1);
                }
        });
        }
    }

    function Requestdetail(obj) {
        var url = '@Url.Action("EmiInfo", "SummeryDetail")?Id=' + obj;
        window.location.href = url;
    }

    $("#btnSearch").click(function () {
        GetData();
    })
</script>

<style>
    .classname {
        position: absolute;
        z-index: 10;
        top: 300px;
        left: 600px;
    }
</style>

