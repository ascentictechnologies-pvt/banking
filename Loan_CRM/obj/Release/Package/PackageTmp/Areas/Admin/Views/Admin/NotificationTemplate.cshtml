@model Loan_CRM.Models.NotificationTemplateVM
@{
    ViewBag.Title = "Notification Template";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<style>
    .has-error {
        color: red !important;
    }
</style>
<h2></h2>
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="col-md-12">
    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Add Notification Template Details</span>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <input type="hidden" id="id" name="id" value="@Model.id" />
                        <label>Template Name</label>
                        @Html.TextBoxFor(x => x.NotificationTemplateName, new { @class = "form-control CharcaterTextBox", @placeholder = "Notification Template Name", @id = "txtname", @maxlength = "100", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.NotificationTemplateName, null, new { @class = "has-error" })
                    </div>
                    <div class="form-group">
                        <label>Template Definition</label>
                        @Html.TextBoxFor(x => x.NotificationTemplateDefinition, new { @class = "form-control CharcaterTextBox", @placeholder = "Notification Template Definition", @id = "txtdefinition", @maxlength = "200", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.NotificationTemplateDefinition, null, new { @class = "has-error" })
                    </div>
                    <div class="form-group">
                        <label>Template Description</label>
                        @Html.TextBoxFor(x => x.NotificationTemplateDesc, new { @class = "form-control CharcaterTextBox", @placeholder = "Notification Template Description", @id = "txtdescription", @maxlength = "250", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.NotificationTemplateDesc, null, new { @class = "has-error" })
                    </div>
                    <div class="panel-footer">
                        <div>
                            <input type="submit" id="btnSave" value="Save" class="btn btn-success" />
                            <input type="button" value="Reset" id="btnReset" class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>SMS Details</span>
                </div>
                <div class="panel-body">
                    <table id="tblNotification" class="table table-striped table-responsive">
                        <thead>
                            <tr>
                                <th>S.No.</th>
                                <th>Template Name</th>
                                <th>Template Description</th>
                                <th>Template Definition</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model.NotificationTemplateList != null && Model.NotificationTemplateList.Count > 0)
                                {
                                    int i = 1;
                                    foreach (var item in Model.NotificationTemplateList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.NotificationTemplateName</td>
                                            <td>@item.NotificationTemplateDefinition</td>
                                            <td>@item.NotificationTemplateDesc</td>
                                            <td>
                                                <a style="cursor:pointer;" onclick="EditData('@item.id')">Edit</a>
                                            </td>
                                        </tr>
                                        i = i + 1;
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblNotification").DataTable();
        $("#btnReset").click(function () {
            $("#id").val("0");
            $("#txtname").val("");
            $("#txtdefinition").val("");
            $("#txtdescription").val("");
            $("#btnSave").val("Save");
        });
    });
    //Remove Validation
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
    $("#btnReset").click(function () {
        window.location.reload();
    });
     function EditData(Id) {
        $.ajax({
            url: '@Url.Action("EditNotificationTemplate", "Admin",new { Area="Admin"})',
            type: "POST",
            data: { Id: Id },
            success: function (result) {
                if (result != null) {
                    $("#id").val(result[0].id);
                    $("#txtname").val(result[0].NotificationTemplateName);
                    $("#txtdefinition").val(result[0].NotificationTemplateDefinition);
                    $("#txtdescription").val(result[0].NotificationTemplateDesc);
                    $("#btnSave").val("Update");
                }
                else {
                    window.location.reload(1);
                }

            },
            error: function (result) {
                window.location.reload(1);
            }
        });
     }
</script>




