 @model Loan_CRM.Models.OccupationModelVM

@{
    ViewBag.Title = "Occupation Master";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<style>
    .has-error {
        color: red !important;
    }
</style>
<h2></h2>
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") ||  Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="col-md-12">
    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Add Occupation Details</span>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <input type="hidden" id="id" name="id" value="@Model.id" />
                        <label>Occupation Name</label>
                        @Html.TextBoxFor(x => x.occupation_name, new { @class = "form-control", @placeholder = "Occupation Name", @maxlength = "50", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.occupation_name, null, new { @class = "has-error" })
                    </div>
                </div>
                <div class="panel-footer">
                    <div>
                        <input type="submit" id="btnSave" value="Save" class="btn btn-success" />
                        <input type="button" value="Reset" id="btnReset" class="btn btn-danger" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Occupation Details</span>
                </div>
                <div class="panel-body">
                    <table id="tblOccupation" class="table table-striped table-responsive">
                        <thead>
                            <tr>
                                <th>SNO</th>
                                <th>Occupation Name</th>
                                <th>Is ORR</th>
                                <th>Created On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model.OccupationModelList != null && Model.OccupationModelList.Count > 0)
                                {
                                    int i = 1;
                                    foreach (var item in Model.OccupationModelList)
                                    {
                            <tr>
                                <td>@i</td>
                                <td>@item.occupation_name</td>
                                <td>
                                    @{
                                        if (item.is_orr)
                                        {
                                           
                                    <a class="anchor" onclick="DisableORR(@item.id)" title="Click to Disable"><img src="~/Content/img/Circle_Green.png" alt="Enable" height="18" width="18" /></a>
                                        }
                                        else
                                        {
                                    <a class="anchor" onclick="EnableORR(@item.id)" title="Click to Enable"><img src="~/Content/img/Circle_Red.png" alt="Enable" height="18" width="18" /></a>
                                        }
                                    }
                                </td>
                                <td>@item.created_on</td>
                                <td>
                                    <a style="cursor:pointer;" onclick="EditData('@item.id')">Edit</a> | @{
                                        if (item.isactive.HasValue == true && item.isactive.Value == true)
                                        {
                                            <a class="anchor" onclick="DisableData(@item.id)" title="Click to Disable"><img src="~/Content/img/Circle_Green.png" alt="Enable" height="18" width="18" /></a>
                                        }
                                        else
                                        {
                                            <a class="anchor" onclick="EnableData(@item.id)" title="Click to Enable"><img src="~/Content/img/Circle_Red.png" alt="Disable" height="18" width="18" /></a>
                                        }
                                    }
                                </td>
                            </tr>
                                        i = i + 1;
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#tblOccupation").DataTable();
        $("#btnReset").click(function () {
            $("#id").val("0");
            $("#occupation_name").val("");
            $("#btnSave").val("Save");
        });
    });
    //Remove Validation
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
    $("#btnReset").click(function () {
        window.location.reload();
    });
    function EditData(Id) {
        
        $.ajax({
            url: '@Url.Action("EditOccupationData", "Admin",new { Area="Admin"})',
            type: "POST",
            data: { Id: Id },
            success: function (result) {
                if (result != null) {
                    
                    $("#id").val(result[0].id);
                    $("#occupation_name").val(result[0].occupation_name);
                    $("#btnSave").val("Update");
                }
                else {
                    window.location.reload(1);
                }
            },
            error: function (result) {
                window.location.reload(1);
            }
        });
    }
    function DisableData(id) {
            var r = confirm("Are you sure to Disable this Occupation?");
            if (r == true) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DisableOccupation", "Admin",new { Area="Admin"})',
                        data: { id: id },
                        success: function (data) {
                            console.log(data);

                            
                                window.location.href = '@Url.Action("OccupationMaster", "Admin",new {Area="Admin"})';
                            
                        }
                    });
            }
        }
        function EnableData(id) {
            var r = confirm("Are you sure to Enable this Occupation?");
            if (r == true) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("EnableOccupation", "Admin",new { Area="Admin"})',
                    data: { id: id },
                    success: function (data) {
                        console.log(data);
                       
                            window.location.href = '@Url.Action("OccupationMaster", "Admin",new {Area="Admin"})';
                        
                    }
                });
            }
    }

        function DisableORR(id) {
            var r = confirm("Are you sure to Disable ORR?");
            if (r == true) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("DisableIsOrrOccupation", "Admin",new { Area="Admin"})',
                        data: { id: id },
                        success: function (data) {
                            console.log(data);

                            
                                window.location.href = '@Url.Action("OccupationMaster", "Admin",new {Area="Admin"})';
                            
                        }
                    });
            }
        }
        function EnableORR(id) {
            var r = confirm("Are you sure to Enable ORR?");
            if (r == true) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("EnableIsOrrOccupation", "Admin",new { Area="Admin"})',
                    data: { id: id },
                    success: function (data) {
                        console.log(data);
                            window.location.href = '@Url.Action("OccupationMaster", "Admin",new {Area="Admin"})';
                        
                    }
                });
            }
        }
</script>
