@model Loan_CRM.Areas.Collector.Models.DefaulterReportModel
@{
    ViewBag.Title = "Defaulter Report";
    Layout = "~/Views/Shared/_LayoutCollector.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
@using (Html.BeginForm("DefaulterReport", "Loanoverdue", FormMethod.Post))
{
    <div id="tableDiv">
        <div class="pull-left">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <td style="text-align:center">
                            <b style="font-size:12px;">Defaulter Report : @Convert.ToString(Model.Report_Name)</b>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="pull-right">
            <table class="table table-bordered table-striped">
                <tbody>
                    <tr>
                        <td style="text-align:center">
                            <input type="button" class="btn btn-xs btn-success" id="btnExportExcel" value="Excel Export" />
                        </td>
                        <td style="text-align:center">
                            <input type="submit" class="btn btn-xs btn-primary" id="btnWeek" value="Week" name="CommandName" onclick="" />
                        </td>
                        <td style="text-align:center">
                            <input type="submit" class="btn btn-xs btn-primary" id="btnMonth" value="Month" name="CommandName" onclick="" />
                        </td>
                        <td style="text-align:center">
                            <input type="submit" class="btn btn-xs btn-primary" id="btnYear" value="Year" name="CommandName" onclick="" />
                        </td>
                        <td style="text-align:center">
                            <input type="button" class="btn btn-xs btn-danger" id="btn_Back" value="Back" onclick="location.href='@Url.Action("DefaulterBucket","Loanoverdue")'" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-md-12">
            <table id="tblReport" class="table table-bordered">
                <thead>
                  
                    <tr>
                        <th>Date</th>
                        <th>Number Defaulter</th>
                        <th>Outstanding Loan Principle</th>
                        <th>Outstanding amount</th>
                        <th>Non-Starter Number</th>
                        <th>Partial Payment Number</th>
                        <th>Defaulter Collection</th>
                        <th>Total No of Defaulter</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.date != null && Model.date.Count > 0)
                    {
                        for (int i = 0; i < Model.date.Count; i++)
                        {
                    <tr>
                        <td>@Model.date[i]<br>@Model.DateRange[i]</td>
                        <td>@Model.Number_Defaulter[i]</td>
                        <td>@Math.Round(Model.Outstanding_Loan_Principle[i], 2)</td>
                        <td>@Math.Round(Model.Outstanding_amount[i], 2)</td>
                        <td>@Model.Non_Starter_Number[i]</td>
                        <td>@Model.Partial_Payment_Number[i]</td>
                        <td>@Model.Defaulter_Collection[i]</td>
                        <td>@Model.Number_Defaulter[i]</td>
                    </tr>
                        }
                        <tr>
                            <th>Total</th>
                            <th>@Math.Round(Model.Sum_Number_Defaulter,2)</th>
                            <th>@Math.Round(Model.Sum_Outstanding_Loan_Principle,2)</th>
                            <th colspan="5"></th>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
}
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnExportExcel").click(function () {
            var dt = new Date();
            var day = dt.getDate();
            var month = dt.getMonth() + 1;
            var year = dt.getFullYear();
            var hour = dt.getHours();
            var mins = dt.getMinutes();
            //
            var table_div = document.getElementById('tblReport');
            var postfix = day + "." + month + "." + year + "_" + hour + "." + mins;
            //creating a temporary HTML link element (they support setting file names)
            var a = document.createElement('a');
            //getting data from our div that contains the HTML table
            var data_type = 'data:application/vnd.ms-excel';

            var table_html = table_div.outerHTML.replace(/ /g, '%20');
            a.href = data_type + ', ' + table_html;
            //setting the file name
            a.download = 'Defaulter' + postfix + '.xls';
            //triggering the function
            a.click();
            //just in case, prevent default behaviour
            e.preventDefault();
        });
    });
</script>

