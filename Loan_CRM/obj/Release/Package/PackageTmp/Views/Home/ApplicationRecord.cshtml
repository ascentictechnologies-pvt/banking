@model Loan_CRM.Models.ApplicationRecordVM
@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="row" id="form-wizard">
    @using (Html.BeginForm("ApplicationRecord", "Home", FormMethod.Post, new { @id = "demo", enctype = "multipart/form-data" }))
    {
        <div class="row">
            <div class="col-md-12 banner-form">
            </div>
        </div>
        <div id="div_FirstStep" class="row">
            <div id="divMsg">
            </div>
            <div class="col-md-10 center-block col-float-none form-bg form-bg-bottom">
                <h2 class="text-center" style="font-size:27px">Enjoy quick and flexible loans today!</h2>
                <p class="text-center" style="margin-bottom: 30px; margin-top: 20px;"><span><img src="../../Content/img/secure-loan.png" style="width: 15px; margin-right: 10px;"></span>Cash Mart uses 256-bit verified encryption to keep your data safe.</p>
                <h3 class="text-contrast text-center text-bg-green padding-small col-md-7 center-block" style="float:none">Step 1: Create Your Login Account</h3>
                <div class="form-wrap row">
                    <div class="form-wrapper-group">
                        <h4 class="text-contrast form-label">Login Details</h4>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    @Html.HiddenFor(x => x.ApplicationNo, new { id = "htApplicationNo" })
                                    <label class="text-contrast"><span class="required-fields">*</span>FIRST NAME</label>
                                    @Html.TextBoxFor(x => x.First_Name, new { id = "txtFirstname", @class = "form-control CharcaterTextBox", @style = "text-transform: uppercase", placeholder = "FIRST NAME", maxlength = "50", @onkeyup = "validateTextBox(this);", @onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.First_Name, null, new { @class = "has-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast">MIDDLE NAME</label>
                                    @Html.TextBoxFor(x => x.Middle_Name, new { id = "txtMiddlename", @class = "form-control CharcaterTextBox", @style = "text-transform: uppercase", placeholder = "MIDDLE NAME", maxlength = "50", @onfocus = "RemoveValidation(this);", @onkeyup = "validateTextBox(this);" })
                                    @Html.ValidationMessageFor(x => x.Middle_Name, null, new { @class = "has-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>LAST NAME</label>
                                    @Html.TextBoxFor(x => x.Last_Name, new { id = "txtLastname", @class = "form-control CharcaterTextBox", @style = "text-transform: uppercase", placeholder = "LAST NAME", maxlength = "50", @onfocus = "RemoveValidation(this);", @onkeyup = "validateTextBox(this);" })
                                    @Html.ValidationMessageFor(x => x.Last_Name, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Email Address</label>
                                    @Html.TextBoxFor(x => x.PersonalEmail, new { id = "txtpersonalemail", @type = "email", @class = "form-control", placeholder = "example@email.com", maxlength = "50", @onfocus = "RemoveValidation(this);", @onchange = "ValidateEmail(this);" })
                                    <input type="hidden" value="texens" id="hdnpersonalmail" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Confirm Email Address</label>
                                    @Html.TextBoxFor(x => x.ConfirmEmail, new { id = "txtConfirmEmail", @type = "email", @class = "form-control", placeholder = "example@email.com", maxlength = "50", @onchange = "CompareEmail();", @onfocus = "RemoveValidation(this);", @onfocusout = "ValidateConfirmEmail(this);" })
                                    @Html.ValidationMessageFor(x => x.ConfirmEmail, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Create Password</label>
                                    @Html.TextBoxFor(x => x.Password, new { id = "txtPassword", @class = "form-control", placeholder = "Create Password", @type = "password", @minlength = "6", @maxlength = "50", @onfocusout = "PasswordLength();", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class=" form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Confirm Password</label>
                                    <div class="input-group">
                                        @Html.TextBoxFor(x => x.confirm_password, new { id = "txtConfirmPassword", placeholder = "Confirm Password", @class = "form-control", @type = "password", @minlength = "6", @maxlength = "50", @onfocusout = "ConfirmPasswordLength();", @onchange = "ComparePassword();", @onfocus = "RemoveValidation(this);" })
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-info btn-flat" id="show_hide" name="show_hide">Show</button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-5">
                                <label class="text-contrast"><span class="required-fields">*</span>Mobile Phone No.</label>
                                <div class="form-group">
                                    <select id="ddlStateList" class="form-control col-md-3 mixselect">
                                        <option value="09">09</option>
                                        <option value="08">08</option>
                                    </select>
                                    @Html.TextBoxFor(x => x.PersonalContactNo, new { id = "txtcontactno", placeholder = "XXXXXXXXXXX", @class = "form-control NumericTextBox mixinput", maxlength = "9", @onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.PersonalContactNo, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 form-wrapper-group" style="margin-top:30px;">
                        <input type="button" id="firstcontinuebtn" style="padding:1.25% 15%;" class="center-block submit-btn" value="Create Account" onclick="FirstContinueClick(this);" />
                    </div>
                </div>
            </div>
        </div>


        <div id="div_FinalStep" class="row" style="display:none;">
            <div id="divMsg1">

            </div>

            <div class="col-md-10 center-block col-float-none form-bg form-bg-bottom">
                <h2 class="text-center" style="font-size:27px">Congratulations, you're almost done!</h2>
                <p class="text-center" style="margin-bottom:30px; margin-top:20px;"><span><img src="../../Content/img/secure-loan.png" style="width: 15px; margin-right: 10px;"></span>Cash Mart uses 256-bit verified encryption to keep your data safe.</p>
                <h3 class="text-contrast text-center text-bg-green padding-small col-md-7 center-block" style="float:none">Step 2: Fill Out the Necessary Information</h3>
                <div class="form-wrap row">
                    <div class="form-wrapper-group">
                        <h4 class="text-contrast form-label">Login Details</h4>
                        <h3><span class="hide" id="lblTimer"></span></h3>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Province</label>
                                    @Html.TextBoxFor(x => x.Province, new { @id = "txtProvince", @class = "form-control", placeholder = "Province", maxlength = "100", @onfocus = "RemoveValidation(this);" })
                                    <input type="hidden" id="province_id" name="province_id" />
                                    @Html.ValidationMessageFor(x => x.Province, null, new { @class = "has-error" })
                                    <label class="has-error" id="txtProvince_lbl"></label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Municipality or City</label>
                                    <input type="text" id="txtCity" name="City_Name" class="form-control CharcaterTextBox" placeholder="Municipality or City" value="@Model.City_Name" onfocus="RemoveValidation(this);" maxlength="50" />
                                    <input type="hidden" id="txtcityId" name="City" />
                                    @Html.ValidationMessageFor(x => x.City_Name, null, new { @class = "has-error" })
                                    <label class="has-error" id="txtCity_lbl"></label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Barangay</label>
                                    @Html.TextBoxFor(x => x.Barangay, new
                                    {
                                        @id = "txtBarangay",
                                        @class = "form-control",
                                        placeholder = "Barangay",
                                        maxlength = "100",
                                        @onfocus = "RemoveValidation(this);"
                                    })
                                    <input type="hidden" id="txtBarangay_id" name="Barangay_id" />
                                    @Html.ValidationMessageFor(x => x.Barangay, null, new { @class = "has-error" })
                                    <label class="has-error" id="txtBarangay_lbl"></label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Complete Address</label>
                                    @Html.TextBoxFor(x => x.Address, new { @id = "txtAddress", @class = "form-control", placeholder = "House #/ Apartment #/ Floor/Condo Unit/Blk, Lot, Phase, SubdivisionName/ Compound/ Street", onfocus = "RemoveValidation(this);", maxlength = "100" })
                                    @Html.ValidationMessageFor(x => x.Address, null, new { @class = "has-error" })

                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Date of Birth </label>
                                    @Html.TextBoxFor(x => x.DOB, new { id = "txtdateofbirth", @class = "form-control", placeholder = "dd-mm-yyyy", onfocus = "RemoveValidation(this);", maxlength = "10", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Civil Status</label>
                                    @Html.DropDownListFor(Model => Model.CivilStatus, new SelectList(ViewBag.CivilStatusData, "civilid", "civilname"), new { @class = "form-control", @id = "ddlcivilstatus", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>SSS No </label>
                                    @Html.TextBoxFor(x => x.SSS_No, new { id = "txtSSS", @class = "form-control NumericTextBox", maxlength = "10", placeholder = "SSS No", onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.SSS_No, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <h4 class="text-contrast form-label">Source Of Income</h4>
                        <div class="col-md-12">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Company/Business Name/Source of Remittance</label>
                                    @Html.TextBoxFor(x => x.CompanyName, new { id = "txtcompanyname", @class = "form-control", placeholder = "Name", onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.CompanyName, null, new { @class = "has-error" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Company/Business/Source of Remittance Address</label>
                                    @Html.TextBoxFor(x => x.CompanyAddress, new { id = "txtcompanybranchaddress", @class = "form-control", placeholder = "Address", onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.CompanyAddress, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Phone No</label>
                                    @Html.TextBoxFor(x => x.Company_Phoneno, new { id = "txtcompanyphone", @class = "form-control NumericTextBox", placeholder = "Phone No", @maxlength = "11", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Joining Date</label>
                                    @Html.TextBoxFor(x => x.JoinDate, new { id = "txtjoiningdate", @class = "form-control", maxlength = "10", placeholder = "dd-mm-yyyy", @readonly = "readonly", @onfocus = "RemoveValidation(this);" })

                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Industry</label>

                                    @Html.DropDownListFor(x => x.Occupation, new SelectList(ViewBag.OccupationData, "id", "occupation_name", "optionGroup", Model.Occupation), new { @id = "ddlIndustry", @class = "form-control", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Position in the Company(type NA if allottee)</label>
                                    @Html.TextBoxFor(x => x.Designation, new { id = "txtposition", @class = "form-control CharcaterTextBox", placeholder = "Position in the Company", onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.Designation, null, new { @class = "has-error" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Gross Monthly Income/Remittance</label>
                                    @Html.TextBoxFor(x => x.GrossIncome, new { id = "txtgrossmonthlyincome", @class = "form-control NumericTextBox", placeholder = "Gross Monthly Income", onfocus = "RemoveValidation(this);", maxlength = "9" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Pay Date1</label>
                                    @Html.DropDownListFor(x => x.PayDate1, new SelectList(Model.PayDateList, "Value", "Text"), new { @id = "ddlPayDate1", @class = "form-control", @onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.PayDate1, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Pay Date2</label>
                                    @Html.DropDownListFor(x => x.PayDate2, new SelectList(Model.PayDate2List, "Value", "Text"), new { @id = "ddlPayDate2", @class = "form-control", @onfocus = "RemoveValidation(this);" })
                                    @Html.ValidationMessageFor(x => x.PayDate2, null, new { @class = "has-error" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <h4 class="text-contrast form-label">Loan Details</h4>
                        <div class="col-md-12">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Loan Amount</label>
                                    @Html.TextBoxFor(x => x.Loan_Amount, new { id = "txtloanamount", @class = "form-control NumericTextBox", placeholder = "Loan Amount", maxlength = "9", onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Term Type</label>
                                    @Html.DropDownListFor(Model => Model.TermType, new SelectList(ViewBag.TermTypeData, "Id", "term_Type"), new { @class = "form-control", @id = "ddltermtype", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="text-contrast"><span class="required-fields">*</span>Terms</label>
                                    @Html.DropDownListFor(Model => Model.TermText, new SelectList(string.Empty, "Id", "term_Name"), "Select", new { @class = "form-control", @id = "ddlterm", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="text-contrast"><span class="required-fields">*</span>Best Time to Call</label>
                        </div>
                        <div class="col-md-12">
                            <div class="col-md-4 col-sm-6">
                                <div class="form-group">
                                    <label class="text-contrast text-center center-block">Morning</label>
                                    @Html.DropDownListFor(x => x.BestTimeToCallMorning_Id, new SelectList(Model.BestTimeToCallMorning, "Value", "Text"), new { @id = "ddl_BestTimeToCallMorning", @class = "form-control", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                            <div class="col-md-4 col-sm-6">
                                <div class="form-group">
                                    <label class="text-contrast text-center center-block">Afternoon</label>
                                    @Html.DropDownListFor(x => x.BestTimeToCallNoon_Id, new SelectList(Model.BestTimeToCallNoon, "Value", "Text"), new { @id = "ddl_BestTimeToCallNoon", @class = "form-control", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <h4 class="text-contrast form-label">Documents</h4>
                        <span class="accepted-file-block">Max size  5mb(JPEG, JPG, PNG or PDF)</span>
                        <div class="col-md-12">
                            <div class="form-group file_upload_wrap">
                                <label class="text-contrast"><span class="required-fields"></span>Attach Goverment ID</label>
                                <input type="file" id="govidFile" style="margin-top: 1%;" name="GovIdFile" onchange="return ValidateFile(this);" />
                            </div>
                            <div class="form-group file_upload_wrap">
                                <label><span class="required-fields"></span>Attach Proof of Income</label>
                                <input type="file" id="incomeFile" style="margin-top: 1%;" name="IncomeIdFile" onchange="return ValidateFile(this);" />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group file_upload_wrap">
                                <label><span class="required-fields"></span>Attach Company ID</label>
                                <input type="file" id="companyidFile" style="margin-top: 1%;" name="CompanyIdFile" onchange="return ValidateFile(this);" />
                            </div>
                            <div class="form-group file_upload_wrap">
                                <label><span class="required-fields"></span>Attach Proof of Billing</label>
                                <input type="file" id="billingFile" style="margin-top: 1%;" name="BillingIdFile" onchange="return ValidateFile(this);" />
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group file_upload_wrap">
                                <label>ATM Attachment</label>
                                <input type="file" id="ATMidFile" style="margin-top: 1%;" name="AtmIdFile" onchange="return ValidateFile(this);" />
                            </div>
                            <div class="form-group file_upload_wrap">
                                <label>Optional Attachment</label>
                                <input type="file" id="otherFile" style="margin-top: 1%;" name="OtherIdFile" onchange="return ValidateFile(this);" />
                            </div>
                        </div>
                    </div>
                    <div class="form-wrapper-group">
                        <div class="col-md-4">
                            <div class=" form-group">
                                <label class="text-contrast" id="lblcode"><span class="required-fields">*</span>Please Enter Code Received Via SMS</label>
                                <div class="input-group">
                                    @Html.TextBoxFor(x => x.code, new { id = "txtCode", @class = "form-control NumericTextBox", placeholder = "Code", @onfocus = "RemoveValidation(this);" })
                                    <span class="input-group-btn">
                                        <input type="button" class="btn btn-info btn-flat" id="btnVerify" value="Verify" />
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="text-contrast" id="lblResend"><span class="required-fields">*</span>Did Not Received Code Via SMS</label>
                                <input type="button" class="btn btn-flat pull-right" id="btnResend" value="Resend" />
                            </div>
                        </div>
                        <div class="form-wrapper-group">
                            <div class="checkbox text-contrast center-block" style="float: none; width: 450px; margin-bottom: 30px; margin-top: 50px;">
                                <label>
                                    <input type="checkbox" checked="checked" id="Term_CheckBox" required="">Yes. I accept the <a href="~/Content/Privacy policy CMA Final .pdf" target="_blank" style="color:#006599">Terms of Agreement</a>.
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 form-wrapper-group">
                            <input type="submit" style="padding:1.25% 15%;margin-top: 0;" class="center-block submit-btn" id="sendapplicationbtn" value="Complete Application" onclick="return Sendapplicationclick();" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<link rel="stylesheet" href="~/Content/App/jquery-ui_App.css">
<script src="~/Content/App/jquery-1.10.2_App.js"></script>
<script src="~/Content/App/jquery-ui_App.js"></script>
<script type="text/javascript">
    var TimerVar = 0;
    var contactno = '';
    var ApplicationNumber = 0;
    var ApplicantName = '';
    $(document).keypress(
        function (event) {
            if (event.which == '13') {
                event.preventDefault();
            }
        });
    function HideIt(id) {
        $(id).hide();
    }
    $(document).ready(function () {
        //Swal.fire(
        //    'Good job!',
        //    'You clicked the button!',
        //    'success'
        //)

        $('input[type="text"]').bind("cut copy paste", function (e) {
            e.preventDefault();
        });
        $("#txtCity").autocomplete({
            source: function (request, response) {
                console.log('%^&&^&', request.term);
                $.ajax({
                    url: '@(Url.Action("City", "Home"))',
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term, ProvinceID: $("#province_id").val() },
