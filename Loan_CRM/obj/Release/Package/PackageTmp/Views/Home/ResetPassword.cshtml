@model Loan_CRM.Models.ApplicationRecordVM
@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
@using (Html.BeginForm())
{
    <div class="login-page">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12 banner-form">
                </div>
            </div>
            <div class="row" id="form-wizard">
                <div class="col-md-8 center-block col-float-none form-bg form-bg-bottom">
                    <h2 class="text-center" style="font-size:27px">Reset Your Password !</h2>
                    <p class="text-center" style="margin-bottom: 30px; margin-top: 20px;"><span><img src="../../Content/img/secure-loan.png" style="width: 15px; margin-right: 10px;"></span>Cash Mart uses 256-bit verified encryption to keep your data safe.</p>
                    <div class="form-wrap">
                        <div class="row">
                            <div class="col-md-10 center-block" style="float:none;">
                                <div class="form-group">
                                    <div id="msgdiv"></div>
                                    @Html.TextBoxFor(x => x.Password, new { id = "txtPassword", @class = "form-control input-lg", placeholder = "Enter New Password", @type = "password", @minlength = "6", @maxlength = "50", @onfocus = "RemoveValidation(this);" })
                                </div>
                                <div class="form-group">
                                    @Html.TextBoxFor(x => x.confirm_password, new { id = "txtConfirmPassword", placeholder = "Enter Confirm Password", @class = "form-control input-lg", @type = "password", @minlength = "6", @maxlength = "50", @onchange = "ComparePassword();", @onfocus = "RemoveValidation(this);" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-10 center-block" style="float:none;">
                                <input type="button" class="submit-btn col-md-12" id="btnSubmit" value="submit" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnSubmit").click(function () {
            //
            var flag = true;
            var Password = $("#txtPassword").val().trim();
            var ConfirmPassword = $("#txtConfirmPassword").val().trim();
            if (Password == '') {
                $("#txtPassword").addClass('has-error');
                $("#txtPassword").val('');
                flag = false;
            }
            if (Password != '') {
                if (Password.length < 6) {
                    alert("Please enter minimum 6 digit or character of Password");
                    $("#txtPassword").addClass('has-error');
                    $("#txtPassword").val('');
                    flag = false;
                }
            }
            if (ConfirmPassword == '') {
                $("#txtConfirmPassword").addClass('has-error');
                $("#txtConfirmPassword").val('');
                flag = false;
            }
            if (ConfirmPassword != '') {
                if (ConfirmPassword.length < 6) {
                    alert("Please enter minimum 6 digit or character of Confirm Password");
                    $("#txtConfirmPassword").addClass('has-error');
                    $("#txtConfirmPassword").val('');
                    flag = false;
                }
            }
             if(flag==true)
            {
                $.ajax({
                    data: { password: Password },
                    url: '@Url.Action("UpdatePassword","Home")',
                    success: function (Result)
                    {
                        if (Result) {
                            alert("Password has been Reset Successfully...");
                            window.location = '@Url.Action("UserLogin","Home")';
                        }
                        else {
                            $("#msgdiv").show();
                            $("#msgdiv").html("<div class='alert alert-danger' style='background-color: #dd4b39;color:white;'>Link Has been Expired.</div>");
                        }
                    }
                })
            }
        });
    });
    function ComparePassword() {
        var pwd = $("#txtPassword").val();
        var confirmPwd = $("#txtConfirmPassword").val();
        if (pwd != confirmPwd) {
            alert("Confirm Password should match Password.")
            $("#txtConfirmPassword").addClass('has-error');
            $("#txtConfirmPassword").val('');
            $("#txtConfirmPassword").focus();
        }
    }
    //Remove Validation
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass('has-error');
        runEffect();
    }
    function runEffect() {
        $("#msgdiv").fadeOut(), 300;
    }
</script>

<style>
    .has-error {
        border-color: red;
        color: red;
    }
</style>
