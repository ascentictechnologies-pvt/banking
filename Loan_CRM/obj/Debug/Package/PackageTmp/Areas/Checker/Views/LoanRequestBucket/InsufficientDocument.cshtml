
@using System.Configuration;

@model IEnumerable<Loan_CRM.Areas.Checker.Models.Checkerdetail>

@{
    ViewBag.Title = "Insufficient Document";
    Layout = "~/Views/Shared/_LayoutChecker.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
@if (TempData["Success"] != null)
{
    <center>
        <div class="col-lg-12 alert alert-success">@TempData["Success"].ToString()</div>
    </center>
}
<div class="pull-left">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <td style="text-align:center">
                    <b style="font-size:20px;">Insufficient Document Application Form List</b>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="pull-right">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>

                <td style="text-align:center">
                    <input type="button" style="float: right; margin-right: 10%;" class="btn btn-primary btn-flat" value="Back" onclick="location.href='@Url.Action("LoanRequest", "LoanRequestBucket" ) '" />
                </td>
                <td style="text-align:center">
                    <input type="button" style="float: right; margin-right: 10%;" class="btn btn-primary btn-flat" value="For Recheck" onclick="location.href='@Url.Action("RecheckRequestBucket", "LoanRequestBucket" ) '" />
                </td>
            </tr>
        </tbody>
    </table>
</div>


<div>


</div>

@{
    Loan_CRM.Areas.Checker.Models.Checkerdetail product = new Loan_CRM.Areas.Checker.Models.Checkerdetail();
}
<table id="tblVerify" class="table table-bordered dataTable no-footer">
    <thead><tr><th>Sr No.</th><th> Applicant No</th><th>Applicant Name</th><th>Request Date</th><th>Best Call Morning</th><th>Best Call Noon</th><th>Action</th><th></th><th></th></tr></thead>
</table>
<script type="text/javascript">
    $(document).ready(function () {
        GetData();
    });
    function GetData() {

        var table=  $("#tblVerify").DataTable({
            "processing": true, // for show progress bar
            "serverSide": true,
            "filter": true,
            "orderMulti": false, // for disable multiple column at once
            "pageLength": 10,
            "lengthChange": false,
            "bInfo": false,
                "ajax": {
                    "url": '@Url.Action("GetInsufficientData", "LoanRequestBucket", new { Area = "Checker" })',
                    "type": "POST",
                    "datatype": "json",
                    error: function (data) {
                        window.location.reload(1);
                    }
                },
            "columns": [
                    { "data": "Id", "name": "Id" },
                    { "data": "applicationno", "name": "applicationno" },
                    { "data": "applicationname", "name": "applicationname" },
                    { "data": "RequestDate", "name": "RequestDate"},
                    { "data": "MorningTime", "name": "MorningTime" },
                    { "data": "NoonTime", "name": "NoonTime" },
                    {
                        "render": function (data, type, full, meta) {
                            if (full.ispickedchecker == true) {
                                return '<span style="color:red;">In Process...</span>';
                            }
                            else {
                                return '<input type="button" value="Detail" class="btn btn-primary" id="btnDetail" onclick="Requestdetail(' + full.applicationno + ',' + full.personalcontactno + ')"/>';
                            }
                        }
                    },
                    {
                        "render": function (data, type, full, meta) {
                            if (full.term != 0) {
                                return '<img src="../../Content/img/Circle_Green.png" style="margin-left: 8%;"/>';
                            }
                            else {
                                return '<img src="../../Content/img/Circle_Yellow.png" style="margin-left: 8%;"/>';
                            }
                        }
                    },
                    {
                        "render": function (data, type, full, meta) {
                            if (full.companyid_url != '' && full.gov_id_url != '' && full.billing_url != '' && full.income_url != '') {
                                return  '<img src="../../Content/img/Circle_Green.png" style="margin-left: 8%;"/>';
                            }
                            else {
                                return  '<img src="../../Content/img/Circle_Yellow.png" style="margin-left: 8%;"/>';
                            }
                        }
                }
            ]
        });
      setInterval(function () {
            table.ajax.reload();
        }, @Convert.ToInt32(ConfigurationManager.AppSettings["GridRefreshTime"]));
    };


    function Requestdetail(obj, obj1) {
        var url = '@Url.Action("RequestDetail", "LoanRequestBucket")?Id=' + obj + '&phoneNumber=' + obj1 + '&Actionname=InsufficientDocument';
        window.location.href = url;
    }

</script>
<style>
    .classname {
        position: absolute;
        z-index: 10;
        top: 300px;
        left: 600px;
    }
</style>