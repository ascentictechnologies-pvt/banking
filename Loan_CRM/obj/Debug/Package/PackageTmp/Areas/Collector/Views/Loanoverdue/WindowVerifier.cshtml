@model Loan_CRM.Models.CompleteAppVerificationDetails
@{
    ViewBag.Title = "VerificationWindow";
    Layout = "~/Views/Shared/_LayoutCollector.cshtml";
}
<div class="pull-left">
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <td style="text-align:center">
                    <b style="font-size:20px;">Verification Window</b>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="pull-right">
    @Html.HiddenFor(x => x.userid)
    <input type="hidden" name="GovUrl" value="@Model.GovUrl" />
    <input type="hidden" name="CompUrl" value="@Model.CompUrl" />
    <input type="hidden" name="IncomeUrl" value="@Model.IncomeUrl" />
    <input type="hidden" name="BillUrl" value="@Model.BillUrl" />
    <input type="hidden" name="OthUrl" value="@Model.OthUrl" />
    <input type="hidden" name="ATMUrl" value="@Model.ATMUrl" />
    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                @if (!String.IsNullOrWhiteSpace(Model.jumioreference))
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("TongdonData", "Home", new { Area = "" })?ReferenceNo=@Model.jumioreference' title="Jumio Reference" target="_blank">Other Data</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.GovUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="GovermentID Document missing!">ID1</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.GovUrl' title="GovermentID Document" target="_blank">ID1</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.CompUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Company Document missing!">ID2</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.CompUrl' title="Company Document" target="_blank">ID2</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.IncomeUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Income Document missing!">PI</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.IncomeUrl' title="Income Document" target="_blank">PI</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.BillUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Bill Document missing!">PB</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.BillUrl' title="Bill Document" target="_blank">PB</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.OthUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="Other Document missing!">O</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.OthUrl' title="Other Document" target="_blank">O</a></td>
                }
                @if (String.IsNullOrWhiteSpace(Model.ATMUrl))
                {
                    <td style="text-align:center"><a class="btn btn-danger" title="ATM Document missing!">A</a></td>
                }
                else
                {
                    <td style="text-align:center"><a class="btn btn-primary" title="ATM Document" href='@Url.Action("DownloadAttachment", "Home", new { Area = "" })?url=@Model.ATMUrl' target="_blank">A</a></td>
                }
                <td></td>
                <td><input type="button" id="btnBack" value="Back" class="btn btn-primary" onclick="UpdateIsPickedVerifier()" /></td>
            </tr>
        </tbody>
    </table>
</div>
<style type="text/css">
    .checkcenter {
        text-align: center;
        align-items: center;
        vertical-align: middle !important;
    }
</style>
<div class="col-md-12">
    <table class="table table-bordered dataTable no-footer table-striped">
        <tr>
            <th colspan="2"><h5><strong>Application No:</strong> <span id="spnAppNo">@Model.ApplicationNo</span></h5></th>
            <th style="vertical-align:middle !important;" width="20%">Remarks</th>
        </tr>
        <tr class="alert alert-info">
            <th style="text-align:center;width:20%"><h5><strong>Personal Information</strong></h5></th>
            <th style="text-align:center;width:30%"><h5><strong>(System or Mannual Input)</strong></h5></th>
            <th style="text-align:center"><h5><strong>Remarks</strong></h5></th>
        </tr>
        <tr>
            <td><label>Name</label></td>
            <td>
                <input type="text" class="form-control" value="@Model.Name" readonly />
                <input type="hidden" name="Name" value="@Model.Name" />
            </td>
            <td><input type="text" class="form-control" name="personal_name_remark" id="personal_name_remark" value="@Model.personal_name_remark" /> </td>
        </tr>
        <tr>
            <td><label>Date Of Birth</label></td>
            <td>
                <input type="text" class="form-control" value="@Model.DOB" readonly />
            </td>
            <td><input type="text" class="form-control" name="personal_birth_date_remark" id="personal_birth_date_remark" value="@Model.personal_birth_date_remark" /></td>
        </tr>
        <tr>
            <td><label>Personal Email Address</label></td>
            <td>
                <input type="text" class="form-control" value="@Model.PersonalEmail" readonly />
                <input type="hidden" name="PersonalEmail" value="@Model.PersonalEmail" />
            </td>
            <td><input type="text" class="form-control" name="personal_email_remark" id="personal_email_remark" value="@Model.personal_email_remark" /></td>
        </tr>
        <tr>
            <td><label>Personal Contact No.</label></td>
            <td>
                <input type="text" class="form-control" value="@Model.PersonalContactNo" readonly />
                @Html.HiddenFor(x => x.PersonalContactNo)
            </td>
            <td><input type="text" class="form-control" name="personal_contact_no_remark" id="personal_contact_no_remark" value="@Model.personal_contact_no_remark" /></td>
        </tr>
        <tr>
            <td><label>Present/Current Address</label></td>
            <td>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="Address" value="@Model.Address.ToUpper()" id="Address" />
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control" value="@Model.BarangayName.ToUpper(), @Model.CityName.ToUpper(), @Model.ProvinceName.ToUpper() " readonly />
                </div>
            </td>
            <td><input type="text" class="form-control" name="personal_perma_address_remark" id="personal_perma_address_remark" value="@Model.personal_perma_address_remark" /></td>
        </tr>
        <tr>
            <td><label>Nearest Landmark/Main Rd.</label></td>
            <td>
                <input type="text" class="form-control" name="nearest_landmark" value="@Model.nearest_landmark" id="nearest_landmark" />
            </td>
            <td><input type="text" class="form-control" name="nearest_landmark_remark" id="nearest_landmark_remark" value="@Model.nearest_landmark_remark" /></td>
        </tr>
        <tr>
            <td><label>SSS No.</label></td>
            <td>
                <input type="text" class="form-control" value="@Model.SSS_No" readonly />
            </td>
            <td><input type="text" class="form-control" name="SSS_No_remark" id="SSS_No_remark" value="@Model.SSS_No_remark" /></td>
        </tr>
        <tr>
            <td><label>Rented/ Owned/ Mortgage?</label></td>
            <td><input type="text" class="form-control" name="home_status_text" id="home_status_text" value="@Model.home_status_text" /></td>
            <td><input type="text" class="form-control" name="rented_mortgage_owned_remark" id="rented_mortgage_owned_remark" value="@Model.rented_mortgage_owned_remark" /></td>
        </tr>
        <tr>
            <td><label>Permanent Address</label></td>
            <td>
                <input type="text" class="form-control" name="Permanent_address" value="@Model.Permanent_address" id="Permanent_address" />
            </td>
            <td><input type="text" class="form-control" name="Permanent_address_remark" id="Permanent_address_remark" value="@Model.Permanent_address_remark" /></td>
        </tr>
        <tr>
            <td><label>Do you intend to transfer residence in the next 30 days?</label></td>
            <td>
                @(Model.YesNoList.FirstOrDefault(x=>x.Value==Model.tansfer_residence).Text)
            </td>
            <td><input type="text" class="form-control" name="tansfer_residence_remark" id="tansfer_residence_remark" value="@Model.tansfer_residence_remark" /></td>
        </tr>
        <tr>
            <td><label>Home Phone No.</label></td>
            <td>
                <div class="input-group">
                    <input type="text" class="form-control NumericTextBox" name="HomePhone" value="@Model.HomePhone" maxlength="11" id="txtHomePhoneNo" aria-describedby="button-addon2" />
                    <div class="input-group-append">
                        <button id="btnHomeCall" class="btn btn-primary btn-outline-secondary" onclick="HomeCall();">Call</button>
                    </div>
                </div>
            </td>
            <td><input type="text" class="form-control" name="personal_house_ph_remark" id="personal_house_ph_remark" value="@Model.personal_house_ph_remark" /></td>
        </tr>
        <tr>
            <td><label>Civil Status</label></td>
            <td>
                <input id="CivilStatus" type="hidden" name="CivilStatus" value="@Model.CivilStatus" />
                <input type="text" class="form-control" value="@Model.CivilStatusText" readonly />
            </td>
            <td><input type="text" class="form-control" name="personal_civil_remark" id="personal_civil_remark" value="@Model.personal_civil_remark" /></td>
        </tr>
        <tr>
            <td><label>Spouse Name (if married)</label></td>
            <td>
                <input type="text" class="form-control" name="spouse_name" value="@Model.spouse_name" id="spouse_name" />
            </td>
            <td><input type="text" class="form-control" name="spouse_name_remark" id="spouse_name_remark" value="@Model.spouse_name_remark" /></td>
        </tr>
        <tr>
            <td><label>Spouse Occupation (if married)</label></td>
            <td>
                <input type="text" class="form-control" name="spouse_occupation" value="@Model.spouse_occupation" id="spouse_occupation" />
            </td>
            <td><input type="text" class="form-control" name="spouse_occupation_remark" id="spouse_occupation_remark" value="@Model.spouse_occupation_remark" /></td>
        </tr>
        <tr>
            <td><label>Number of Dependents</label></td>
            <td>
                <input type="text" class="form-control" name="number_of_dependent" value="@Model.number_of_dependent" id="number_of_dependent" />
            </td>
            <td><input type="text" class="form-control" name="number_of_dependent_remark" id="number_of_dependent_remark" value="@Model.number_of_dependent_remark" /></td>
        </tr>
        <tr>
            <td><label>Mother's Maiden Name and Work</label></td>
            <td>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="MotherMaidenName" placeholder="Name" value="@Model.MotherMaidenName" id="MotherMaidenName" />
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="mother_work" value="@Model.mother_work" placeholder="Works" id="mother_work" />
                </div>
            </td>
            <td><input type="text" class="form-control" name="personal_mother_maiden_name_remark" id="personal_mother_maiden_name_remark" value="@Model.personal_mother_maiden_name_remark" /></td>
        </tr>
        <tr>
            <td><label>Father's Name and Work</label></td>
            <td>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="father_name" placeholder="Father Name" value="@Model.father_name" id="father_name" />
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="father_work" value="@Model.father_work" placeholder="Works" id="father_work" />
                </div>
            </td>
            <td><input type="text" class="form-control" name="father_name_work_remark" id="father_name_work_remark" value="@Model.father_name_work_remark" /></td>
        </tr>
        <tr>
            <td><label>Are You Living with Mother? Address</label></td>
            <td>
                <div class="col-sm-6">
                    @(Model.YesNoList.FirstOrDefault(x=>x.Value==Model.living_with_mother).Text)
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="MotherAddress" placeholder="Mother Address" value="@Model.MotherAddress" id="MotherAddress" />
                </div>
            </td>
            <td><input type="text" class="form-control" name="personal_mother_perma_add_remark" id="personal_mother_perma_add_remark" value="@Model.personal_mother_perma_add_remark" /></td>
        </tr>
        <tr>
            <td><label>How many Siblings and Work</label></td>
            <td>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="sibling_count" value="@Model.sibling_count" id="sibling_count" />
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="sibling_works" placeholder="Works" value="@Model.sibling_works" id="sibling_works" />
                </div>
            </td>
            <td><input type="text" class="form-control" name="sibling_works_remark" id="sibling_works_remark" value="@Model.sibling_works_remark" /></td>
        </tr>
        <tr>
            <td><label>Occupation</label></td>
            <td>
                @(Model.OccupationModelList.FirstOrDefault(x=>x.id==Convert.ToInt32(Model.occupation)).occupation_name)
            </td>
            <td><input type="text" class="form-control" name="occupation_remark" id="occupation_remark" value="@Model.occupation_remark" /></td>
        </tr>
        <tr class="alert alert-info">
            <th style="text-align:center"><h5><strong>Employement Details</strong></h5></th>
            <th style="text-align:center"><h5><strong>(System or Mannual Input)</strong></h5></th>
            <th style="text-align:center"><h5><strong>Remarks</strong></h5></th>
        </tr>
        <tr>
            <td><label>Company Name/ Nature of Business</label></td>
            <td>
                <input type="text" class="form-control" name="CompanyName" value="@Model.CompanyName" id="CompanyName" />
            </td>
            <td><input type="text" class="form-control" name="personal_company_name_remark" id="personal_company_name_remark" value="@Model.personal_company_name_remark" /></td>
        </tr>
        <tr>
            <td><label>Company Address/ Office Contact</label></td>
            <td>
                <input type="text" class="form-control" name="CompanyAddress" value="@Model.CompanyAddress" id="CompanyAddress" />
                <input type="text" class="form-control" name="CompanyAddress" value="@Model.Company_Phoneno" id="Company_Phoneno" readonly />
            </td>
            <td><input type="text" class="form-control" name="personal_company_address_remark" id="personal_company_address_remark" value="@Model.personal_company_address_remark" /></td>
        </tr>
        <tr>
            <td><label>Job Title/ Dept./ Function/ Tenurity</label></td>
            <td>
                <input type="text" name="Designation" value="@Model.Designation" class="form-control" id="Designation" />
            </td>
            <td><input type="text" class="form-control" name="personal_job_title_remark" id="personal_job_title_remark" value="@Model.personal_job_title_remark" /></td>
        </tr>
        <tr>
            <td><label>Gross Monthly Income w/ Incentive and Allowance</label></td>
            <td>
                <input type="text" class="form-control" name="GrossIncome" value="@Model.GrossIncome" id="GrossIncome" />
            </td>
            <td><input type="text" class="form-control" name="personal_monthly_income_remark" id="personal_monthly_income_remark" value="@Model.personal_monthly_income_remark" /></td>
        </tr>
        <tr>
            <td><label>Net Monthly Income (w/ Deduction)</label></td>
            <td>
                <input type="text" class="form-control" name="net_income" placeholder="" value="@Model.net_income" id="net_income" />
            </td>
            <td><input type="text" class="form-control" name="net_income_remark" id="net_income_remark" value="@Model.net_income_remark" /></td>
        </tr>
        <tr>
            <td><label>Schedule & BTC</label></td>
            <td>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="scheduled_and_btc" value="@Model.MorningTime" readonly />
                </div>
                <div class="col-sm-6">
                    <input type="text" class="form-control" name="scheduled_and_btc1" value="@Model.NoonTime" readonly />
                </div>
            </td>
            <td><input type="text" class="form-control" name="scheduled_and_btc_remark" id="scheduled_and_btc_remark" value="@Model.scheduled_and_btc_remark" /></td>
        </tr>
        <tr>
            <td><label>Pay Date</label></td>
            <td>
                <div class="col-sm-6">
                    @(Model.PayDateList.FirstOrDefault(x=>x.Value==Model.payDate1).Text)
                </div>
                <div class="col-sm-6">
                    @(Model.PayDate2List.FirstOrDefault(x=>x.Value==Model.payDate2).Text)
                    @Html.HiddenFor(x => x.payDate2)
                </div>
            </td>
            <td><input type="text" class="form-control" name="pay_date_remark" id="pay_date_remark" value="@Model.pay_date_remark" /></td>
        </tr>
        <tr>
            <td><label>Do you have pending resignation?</label></td>
            <td>
                @(Model.YesNoList.FirstOrDefault(x=>x.Value==Model.pending_resignation).Text)
            </td>
            <td><input type="text" class="form-control" name="pending_resignation_remark" id="pending_resignation_remark" value="@Model.pending_resignation_remark" /></td>
        </tr>
        <tr>
            <td><label>Other Source of Income? Remittance/ Business</label></td>
            <td>
                <input type="text" class="form-control" name="other_source_of_income" value="@Model.other_source_of_income" id="other_source_of_income" />
            </td>
            <td><input type="text" class="form-control" name="other_source_of_income_remark" id="other_source_of_income_remark" value="@Model.other_source_of_income_remark" /></td>
        </tr>
        <tr class="alert alert-info">
            <th style="text-align:center"><h5><strong>Loan Details</strong></h5></th>
            <th style="text-align:center"><h5><strong>(System or Mannual Input)</strong></h5></th>
            <th style="text-align:center"><h5><strong>Remarks</strong></h5></th>
        </tr>
        <tr>
            <td><label>Ask how did they know Cash Mart/ First time</label></td>
            <td>
                <input type="text" class="form-control" name="know_about_cashmart" value="@Model.know_about_cashmart" id="know_about_cashmart" />
            </td>
            <td><input type="text" class="form-control" name="know_about_cashmart_remark" id="know_about_cashmart_remark" value="@Model.know_about_cashmart_remark" /></td>
        </tr>
        <tr>
            <td><label>Any PENDING Loans from other landing co.</label></td>
            <td>
                <input type="text" class="form-control" name="pending_loan_fron_otherland" value="@Model.pending_loan_fron_otherland" id="pending_loan_fron_otherland" />
            </td>
            <td><input type="text" class="form-control" name="pending_loan_fron_otherland_remark" id="pending_loan_fron_otherland_remark" value="@Model.pending_loan_fron_otherland_remark" /></td>
        </tr>
        <tr>
            <td><label>Any Bank Loans/ credit Card</label></td>
            <td>
                <input type="text" class="form-control" name="bank_loan_or_credit_card" value="@Model.bank_loan_or_credit_card" id="bank_loan_or_credit_card" />
            </td>
            <td><input type="text" class="form-control" name="bank_loan_or_credit_card_remark" id="bank_loan_or_credit_card_remark" value="@Model.bank_loan_or_credit_card_remark" /></td>
        </tr>
        <tr>
            <td><label>Requested Loan Amount</label></td>
            <td>
                <input type="text" class="form-control" name="AdditionalRequestedLoanAmount" value="@Model.Loan_Amount" readonly id="AdditionalRequestedLoanAmount" />
            </td>
            <td><input type="text" class="form-control" name="personal_req_loan_amt_remark" id="personal_req_loan_amt_remark" value="@Model.personal_req_loan_amt_remark" /></td>

        </tr>
        <tr>
            <td><label>Requested Term</label></td>
            <td>
                <input type="text" class="form-control" value="@Model.AdditionalRequested_Term" readonly />
            </td>
            <td><input type="text" class="form-control" name="personal_req_loan_term_remark" id="personal_req_loan_term_remark" value="@Model.personal_req_loan_term_remark" /></td>
        </tr>
        <tr>
            <td><label>Purpose of Loan</label></td>
            <td>
                <input type="text" class="form-control" name="AdditionalLoanPurpose" value="@Model.AdditionalLoanPurpose" id="AdditionalLoanPurpose" />
            </td>
            <td><input type="text" class="form-control" name="personal_monthly_income_remark" id="personal_monthly_income_remark" value="@Model.AdditionalLoanPurpose_Remark" /></td>
        </tr>
        <tr>
            <td><label>Bank Name</label></td>
            <td>
                @Model.BankName
            </td>
            <td><input type="text" class="form-control " name="personal_bank_name_remark" id="personal_bank_name_remark" value="@Model.personal_bank_name_remark" /></td>
        </tr>
        <tr>
            <td><label>Bank Account No.</label></td>
            <td>
                <input type="text" min="0" class="form-control" name="BankAccNo" value="@Model.BankAccNo" id="BankAccNo" maxlength="16" />
            </td>
            <td><input type="text" class="form-control" name="personal_bank_ac_no_remark" id="personal_bank_ac_no_remark" value="@Model.personal_bank_ac_no_remark" /></td>
        </tr>
        <tr class="alert alert-info">
            <th style="text-align:center"><h5><strong>Reference Verification</strong></h5></th>
            <th style="text-align:center"><h5><strong>(System or Mannual Input)</strong></h5></th>
            <th style="text-align:center"><h5><strong>Remarks</strong></h5></th>
        </tr>
        <tr>
            <th style="text-align:center" colspan="3"><h5><span>Family</span></h5></th>
        </tr>
        <tr>
            <td><label>Name</label></td>
            <td>
                <input type="text" class="form-control" name="family_name1" value="@Model.family_name1" id="family_name1" />
            </td>
            <td><input type="text" class="form-control" name="family_name1_remark" id="family_name1_remark" value="@Model.family_name1_remark" /></td>
        </tr>
        <tr>
            <td><label>Address</label></td>
            <td>
                <input type="text" class="form-control" name="family_address1" value="@Model.family_address1" id="family_address1" />
            </td>
            <td><input type="text" class="form-control" name="family_address1_remark" id="family_address1_remark" value="@Model.family_address1_remark" /></td>
        </tr>
        <tr>
            <td><label>Contact Number</label></td>
            <td>
                <div class="col-md-6">
                    <input type="text" maxlength="11" onkeyup="" class="form-control" name="family_contact1" value="@Model.family_contact1" id="family_contact1" />
                </div>
                <div class="col-md-6">
                    <input type="button" value="Call" id="btnFamily1Call" class="btn btn-primary" onclick="Family1Call();" />
                </div>
            </td>
            <td><input type="text" class="form-control" name="family_contact1_remark" id="family_contact1_remark" value="@Model.family_contact1_remark" /></td>
        </tr>
        <tr>
            <td><label>Relation to Borrower</label></td>
