<div class="col-md-6">
    <table id="ApproverLoanDetails" border="1" class="table table-bordered table-responsive table-striped">
        <tr><th colspan="2">Approved Loan Details</th></tr>
        <tr>
            <td width="40%">Approve Loan Amount</td>
            <td width="60%">
                <input type="number" min="0" class="form-control NumericTextBox" name="ApprovedLoanAmount" id="ApprovedLoanAmount" value="@Model.ApprovedLoanAmount" />
                <input type="hidden" name="ApprovedLoanAmount" value="@Model.ApprovedLoanAmount" />
            </td>
        </tr>
        <tr>
            <td>Term Name</td>
            <td><select class="form-control" name="TermName" id="ddlTermName" onchange="GetDataAccToTerm()"><option value="-1">Select</option></select></td>
        </tr>
        <tr>
            <td>Term Type</td>
            <td><input type="text" class="form-control" name="ApprovedTermType" id="txtTermType" value="@Model.TermType" readonly /></td>
        </tr>
        <tr>
            <td>Term Value</td>
            <td>
                <input type="text" class="form-control" name="ApprovedTerm" id="txtTerm_Value" value="@Model.ApprovedTerm" readonly />
                <input type="hidden" name="ApprovedTermId" id="txtTerm_Id" />
            </td>
        </tr>

        <tr>
            <td>Interest Rate</td>
            <td><input type="text" class="form-control" name="ApprovedInterestRate" id="txtInterestRate" value="@Model.ApprovedInterestRate" readonly /></td>
        </tr>
        <tr>
            <td>Maturity Date</td>
            <td><input type="text" class="form-control" name="ApprovedMaturityDate" id="txtApprovedMaturityDate" value="@Model.ApprovedMaturityDate" autocomplete="off" /></td>
        </tr>
        <tr>
            <td>Total Amount Due</td>
            <td><input type="text" class="form-control NumericTextBox" name="ApprovedTotalDueAmount" id="ApprovedTotalDueAmount" value="@Model.ApprovedTotalDueAmount" readonly /></td>
        </tr>
        <tr>
            <td>Disbursement Date</td>
            <td><input type="text" class="form-control" name="disbursement_date" id="disbursement_date" value="@Model.disbursement_date" readonly /></td>
        </tr>
    </table>
    <table style="margin-top: 3%;" id="tblCheckerHistory" border="1" class="table table-bordered table-responsive table-striped">
        @{

            <tr>
                <th>Checker Name : </th>
                <td colspan="3">@Model.checker_name</td>
            </tr>
            <tr>
                <th colspan="4" style="text-align:center">Remark History</th>
            </tr>
            <tr>
                <th>Application No</th>
                <th>Date</th>
                <th>Remark</th>
                <th>Remark By</th>
            </tr>
            if (Model.RemarkModelList != null && Model.RemarkModelList.Count > 0)
            {
                foreach (var item in Model.RemarkModelList)
                {
                    var remarkOn = item.createdon.ToString("dd-MM-yyyy hh:mm tt");
                    <tr>
                        <td>@item.application_id</td>
                        <td>@remarkOn</td>
                        <td>@item.remark</td>
                        <td>@item.createdbyname</td>
                    </tr>
                }
            }
        }
    </table>
    <table style="margin-top: 3%;" id="tblRemarks" border="1" class="table table-bordered table-responsive table-striped">
    </table>
</div>
<script src="https://code.jquery.com/ui/1.10.2/jquery-ui.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        GetLastRemark();
    });
     function GetLastRemark() {
         var tblRemarks = $("#tblRemarks");
         $.ajax({
             url: '@Url.Action("GetLastPaymentRemark", "LoanRequestVerifier")',
             type: "POST",
             data: { ApplicationNo: @Model.ApplicationNo, UserId: @Model.userid },
             success: function (result) {
                 tblRemarks.append('<thead><tr><th style="text-align:center">Payment Remark History</th></tr></thead><tbody><tr><td>' + result + '</td></tr></tbody>')
                },
                error: function (result) {
                    window.location.reload(1);
                }
            })
    }
</script>