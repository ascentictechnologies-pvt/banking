@model Loan_CRM.Models.EmailTemplateModelVM
@{
    ViewBag.Title = "E-Mail Template";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    @Styles.Render("~/Content/DataTable");
    @Scripts.Render("~/Script/DataTable");
}
<style>
    .has-error {
        color: red !important;
    }
</style>
<h2></h2>
<div id="MsgDiv">
    @if (TempData["msg"] != null)
    {
        if (Convert.ToString(TempData["msg"]).ToLower().Contains("wrong") || Convert.ToString(TempData["msg"]).ToLower().Contains("not") || Convert.ToString(TempData["msg"]).ToLower().Contains("exception"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-danger'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else if (Convert.ToString(TempData["msg"]).ToLower().Contains("duplicate") || Convert.ToString(TempData["msg"]).ToLower().Contains("already") || Convert.ToString(TempData["msg"]).ToLower().Contains("exist"))
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-warning'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            <div onclick="$('#MsgDiv').hide(500);" class='alert alert-success'>
                <label>@TempData["msg"]</label><a onclick="$('#MsgDiv').hide(500);" class="anchor pull-right"><i class="fa fa-window-close" aria-hidden="true"></i></a>
            </div>
        }
    }
</div>
<div class="col-md-12">
    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>Add EMailTemplate Details</span>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <input type="hidden" id="id" name="id" value="@Model.id" />
                        <label>E-Mail Template Name</label>
                        @Html.TextBoxFor(x => x.email_template_name, new { @class = "form-control CharcaterTextBox", @placeholder = "E-Mail Template Name", @id = "txtemail_template_name", @maxlength = "100", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.email_template_name, null, new { @class = "has-error" })
                    </div>
                    <div class="form-group">
                        <label>E-Mail Template Definition</label>
                        @Html.TextBoxFor(x => x.email_template_definition, new { @class = "form-control CharcaterTextBox", @placeholder = "E-Mail Template Definition", @id = "txtemail_template_definition", @maxlength = "200", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.email_template_definition, null, new { @class = "has-error" })
                    </div>
                    <div class="form-group">
                        <label>E-Mail Template Description</label>
                        @Html.TextBoxFor(x => x.email_template_description, new { @class = "form-control CharcaterTextBox", @placeholder = "E-Mail Template Description", @id = "txtemail_template_description", @maxlength = "250", @onfocus = "RemoveValidation(this);" })
                        @Html.ValidationMessageFor(x => x.email_template_description, null, new { @class = "has-error" })
                    </div>
                </div>
                <div class="panel-footer">
                    <div>
                        <input type="submit" id="btnSave" value="Save" class="btn btn-success" />
                        <input type="button" value="Reset" id="btnReset" class="btn btn-danger" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <span>EMail Details</span>
                </div>
                <div class="panel-body">
                    <table id="tblEmail" class="table table-striped table-responsive">
                        <thead>
                            <tr>
                                <th>SNO</th>
                                <th>Email Template Name</th>
                                <th>Email Template Description</th>
                                <th>Email Template Definition</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model.EMailTemplateList != null && Model.EMailTemplateList.Count > 0)
                                {
                                    int i = 1;
                                    foreach (var item in Model.EMailTemplateList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.email_template_name</td>
                                            <td>@item.email_template_description</td>
                                            <td>@item.email_template_definition</td>
                                            <td>
                                                <a style="cursor:pointer;" onclick="EditData('@item.id')">Edit</a>
                                            </td>
                                        </tr>
                                        i = i + 1;
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblEmail").DataTable();
        $("#btnReset").click(function () {
            $("#id").val("0");
            $("#txtemail_template_name").val("");
            $("#txtemail_template_definition").val("");
            $("#txtemail_template_description").val("");
            $("#btnSave").val("Save");
        });
    });
    $("#btnReset").click(function () {
        window.location.reload();
    });
    //Remove Validation
    function RemoveValidation(obj) {
        var id = obj.id;
        $("#" + id).removeClass("has-error");
    }
     function EditData(Id) {

        $.ajax({
            url: '@Url.Action("EditEmailData", "Admin",new { Area="Admin"})',
            type: "POST",
            data: { Id: Id },
            success: function (result) {

                if (result != null) {
                    $("#id").val(result[0].id);
                    $("#txtemail_template_name").val(result[0].email_template_name);
                    $("#txtemail_template_definition").val(result[0].email_template_definition);
                    $("#txtemail_template_description").val(result[0].email_template_description);
                    $("#btnSave").val("Update");
                }
                else {
                    window.location.reload(1);
                }
            },
            error: function (result) {
                window.location.reload(1);
            }
        });
     }
</script>



